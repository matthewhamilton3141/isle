#!/bin/bash
#
# isle-cli — the bridge script Claude Code's hooks call. Writes a small
# JSON status file that Isle watches with DispatchSource (see the build
# spec, Section 3.3). Deliberately dependency-free (no jq/python required)
# so it can't be the reason a hook fails.
#
# Usage: isle-cli set-state <disconnected|idle|working|needs_approval|done>
#
# Does NOT require Isle.app to be running to succeed — it just writes a
# file. If Isle isn't open, the write is a harmless no-op from Claude
# Code's perspective (exit 0 either way).

set -euo pipefail

STATUS_DIR="$HOME/.isle"
STATUS_FILE="$STATUS_DIR/claude-status.json"

if [ "${1:-}" != "set-state" ] || [ -z "${2:-}" ]; then
  echo "Usage: isle-cli set-state <disconnected|idle|working|needs_approval|done>" >&2
  exit 1
fi

STATE="$2"
PROJECT="$(basename "$PWD")"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

mkdir -p "$STATUS_DIR"

# Heredoc, not jq/python — state and project are the only interpolated
# values, both effectively controlled inputs (a fixed enum + a directory
# name), so this stays simple on purpose. Revisit if you add session_id
# parsing from the hook's stdin JSON later (multi-session stretch goal).
cat > "$STATUS_FILE" <<EOF
{
  "state": "$STATE",
  "project": "$PROJECT",
  "updated_at": "$TIMESTAMP"
}
EOF
