#!/bin/bash
#
# isle-cli — the bridge script Claude Code's hooks call. Writes a small JSON
# status file (~/.isle/claude-status.json) that Isle watches with DispatchSource.
# Dependency-free (no jq/python) so a missing tool can never break a hook. Does
# NOT require Isle.app to be running — it just writes a file (exit 0 either way).
#
# Usage:
#   isle-cli set-state <disconnected|idle|working|done>   # state comes from the hook
#                                                          # (Stop also keeps what the turn left running;
#                                                          # a request being waited on keeps the record)
#   isle-cli notify                                       # route a Notification by its type
#   isle-cli fail                                          # StopFailure → the error, or the usage limit
#   isle-cli ask                                           # permission → block for the notch
#   isle-cli ask-question                                  # AskUserQuestion → block for the notch
#   isle-cli guard                                         # Bash → ask when it's a guarded command
#   isle-cli subagent-start                                # SubagentStart → count it as running
#   isle-cli subagent-stop                                 # SubagentStop → stop counting it
#   isle-cli denied                                        # PermissionDenied → auto mode blocked a call
#   isle-cli end                                           # session ended — clear the island
#
# Kept in sync with Isle's embedded HookInstaller.scriptBody.

set -euo pipefail

STATUS_DIR="$HOME/.isle"
# One file per session. A single shared file meant any session's event
# overwrote every other session's state — so a background session going
# quiet (Stop, or the idle notification) would wipe the state of the
# session you were actually watching. The app now reads the whole directory
# and picks which session owns the island.
SESSION_DIR="$STATUS_DIR/sessions"

# The answering handshake (`ask` / `ask-question`). A blocked hook leaves its
# raw stdin at requests/<id>.json for as long as it waits; Isle answers by
# renaming the complete stdout payload into place at requests/<id>.response.json.
# Isle owns run/answering, which holds its pid and exists only while it is
# running with "Answer questions and approvals from the notch" on — no marker,
# or a dead pid, and nothing blocks at all.
REQUEST_DIR="$STATUS_DIR/requests"
ANSWERING_MARKER="$STATUS_DIR/run/answering"

# How long each blocking verb waits for the notch before falling through to
# Claude's own prompt. An approval can wait long: Claude Code shows its
# terminal dialog *while* the hook runs, so the block costs nothing. A question
# can't: the terminal shows only a spinner until the hook returns. Both sit
# inside the hook's own `timeout` in settings.json (330 / 60), so the script
# always gives up before Claude Code has to kill it.
ASK_APPROVAL_SECONDS=300
ASK_QUESTION_SECONDS=45

# Guarded commands (`guard`): the user's own short list of commands that always
# ask — in auto mode, under acceptEdits, past an allow rule, with permissions
# bypassed. Isle writes it, one pattern a line, by rename, and removes it when
# the feature is off or the list is empty; so with nothing to guard, `guard`
# is one test and an exit, and no session is slowed down.
GUARD_LIST="$STATUS_DIR/guarded-commands"
# Each guarded call of a session's turn, at guarded/<session>/<tool_use_id>.json:
# the pattern it matched, and its command as Claude Code escaped it. The
# PermissionRequest that follows carries neither the reason nor the
# tool_use_id, so this is how the notch knows the approval in front of it is a
# guarded one, and why: the record whose command it is. One a call, so
# parallel guarded calls each keep their own. The next prompt (UserPromptSubmit,
# SessionStart other than a compaction) and the session's end clear them.
GUARD_DIR="$STATUS_DIR/guarded"

# The subagents each session has running (Milestone 22): one file per agent at
# subagents/<session>/<agent_id>, holding its type, made by its SubagentStart
# and removed by its SubagentStop. A file per agent, so parallel agents
# starting and stopping at once never rewrite each other's entries; a stop
# whose start was never seen (Claude Code's own internal agents fire one) finds
# no file and changes nothing. An agent is counted until its own stop, across
# turns: a background agent still running when the turn ends (Stop,
# StopFailure) or the next prompt starts (UserPromptSubmit) is still running.
# Stop also lets go of every agent its `background_tasks` doesn't list (all
# of them when it carries no list): one stopped by Esc gets no SubagentStop
# of its own (see `stop_prune_agents`).
# The session's directory goes only with the session: its end (SessionEnd), or
# a new process taking up its id (SessionStart other than a compaction, as a
# resume does), since the agents of a process that's gone are gone too. One
# killed outside any hook is Isle's to see: it knows the session's pid. The
# record carries the types in the order they started, as `subagents`.
AGENT_DIR="$STATUS_DIR/subagents"

# The last call auto mode blocked in each session (Milestone 23), as one line of
# JSON at blocked/<session>.json, written by `denied` (the PermissionDenied
# hook) and carried into every record as `blocked`. Claude Code 2.1.319 fires
# PermissionDenied only when auto mode's classifier denied the call: never for
# a deny rule, a hook's deny, a person's No, a safety check, or a prompt that
# permissions.denyInsteadOfPrompting turned into a denial. The turn usually
# carries on, so it is an event, not a state: the record keeps its state. It
# stays until the next prompt starts a turn (UserPromptSubmit, SessionStart
# other than a compaction) or the session ends; not at Stop, so the Done face
# can still say what was blocked.
BLOCK_DIR="$STATUS_DIR/blocked"

# What the session's last turn left behind (Milestone 20), as one line of JSON
# at left/<session>.json, written at Stop from its `background_tasks` (the
# shells, agents and other background work still in flight) and
# `session_crons` (the wake-ups scheduled with CronCreate, ScheduleWakeup or
# /loop), and carried into every record as `left`. It is what was so when the
# turn ended, not a live count: a task's own end fires no hook of its own. (Its
# end does wake the session: Claude Code 2.1.319 submits a <task-notification>
# prompt, so UserPromptSubmit clears it and the next Stop says it afresh.) The
# next prompt (UserPromptSubmit, SessionStart other than a compaction), a
# StopFailure and the session's end clear it.
LEFT_DIR="$STATUS_DIR/left"

# This session's leftovers as JSON, in LT_JSON; `null` when there are none.
# Made JSON-safe when stored.
left_json() {
  local id="${SESSION_ID//[^A-Za-z0-9_-]/}" f
  LT_JSON="null"
  [ -n "$id" ] || return 0
  f="$LEFT_DIR/$id.json"
  [ -f "$f" ] || return 0
  { IFS= read -r LT_JSON || [ -n "$LT_JSON" ]; } 2>/dev/null < "$f" || LT_JSON=""
  case "$LT_JSON" in
    '{'*'}') : ;;
    *) LT_JSON="null" ;;
  esac
}

# This session's last block as JSON, in BL_JSON; `null` when there is none,
# which is one file test on nearly every write. Made JSON-safe when stored.
blocked_json() {
  local id="${SESSION_ID//[^A-Za-z0-9_-]/}" f
  BL_JSON="null"
  [ -n "$id" ] || return 0
  f="$BLOCK_DIR/$id.json"
  [ -f "$f" ] || return 0
  { IFS= read -r BL_JSON || [ -n "$BL_JSON" ]; } 2>/dev/null < "$f" || BL_JSON=""
  case "$BL_JSON" in
    '{'*'}') : ;;
    *) BL_JSON="null" ;;
  esac
}

# The running subagents of this session as a JSON array of their types, oldest
# first, in SA_JSON. One directory test and nothing else for a session with
# none, which is nearly every write. Types were made JSON-safe when stored.
subagents_json() {
  local id="${SESSION_ID//[^A-Za-z0-9_-]/}" f t out=""
  local d="$AGENT_DIR/$id"
  SA_JSON="[]"
  [ -n "$id" ] && [ -d "$d" ] || return 0
  while IFS= read -r f; do
    case "$f" in ''|*.*) continue ;; esac
    # Gone between the listing and the read: stopped, so not counted.
    t=""
    { IFS= read -r t || [ -n "$t" ]; } 2>/dev/null < "$d/$f" || continue
    out="$out${out:+, }\"$t\""
  done < <(ls -1tr "$d" 2>/dev/null)
  SA_JSON="[$out]"
}

# Writes the status file Isle watches. $1 = state, $2 = request id (empty for
# every write except a blocked `ask` / `ask-question`). Computes its own
# timestamp so each write carries a fresh "… ago".
write_status() {
  local ts sf tmp seen n=0
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$SESSION_DIR"
  # Keyed by session id. Absent one (a hook payload without stdin), fall
  # back to a fixed name so the write still lands somewhere predictable
  # rather than creating an unbounded set of files.
  sf="$SESSION_DIR/${SESSION_ID:-unknown}.json"
  # Written to a temp file and renamed into place, never edited in place.
  # Isle watches the *directory*, and rewriting an existing file changes no
  # directory entry — so an in-place write fires no event and the app never
  # learns the state changed. A rename does. (It also makes the write atomic,
  # so Isle can never read a half-written record.) The temp name deliberately
  # does not end in .json, so a scan mid-write can't pick it up as a session.
  tmp="$sf.tmp.$$"
  # The running subagents are read from their files at the moment of writing,
  # and again after: a SubagentStart or SubagentStop landing in between would
  # otherwise be lost under this write until the next one. Twice more at most.
  blocked_json
  left_json
  while :; do
  subagents_json
  seen="$SA_JSON"
  cat > "$tmp" <<EOF
{
  "state": "$1",
  "project": "$PROJECT",
  "session_id": "$SESSION_ID",
  "action": "$ACTION",
  "target": "$TARGET",
  "error_type": "$ERROR_TYPE",
  "tool_active": $TOOL_ACTIVE,
  "reset_at": "$RESET_AT",
  "limit_kind": "$LIMIT_KIND",
  "limit_next": "$LIMIT_NEXT",
  "request_id": "$2",
  "request_kind": "${3:-}",
  "last_message": "$LAST_EXCERPT",
  "blocked": $BL_JSON,
  "left": $LT_JSON,
  "subagents": $SA_JSON,
  "updated_at": "$ts"
}
EOF
  mv -f "$tmp" "$sf"
  n=$((n + 1))
  [ "$n" -lt 3 ] || break
  subagents_json
  [ "$SA_JSON" != "$seen" ] || break
  # The session ended meanwhile (SessionEnd took the record): not brought back.
  [ -f "$sf" ] || break
  done
}

# The record at $1 as it is now, whole, into REC; false when there is none.
# Builtins only, so reading it twice costs no fork.
read_record() {
  REC=""
  { IFS= read -r -d '' REC || [ -n "$REC" ]; } 2>/dev/null < "$1"
}

# Puts the rewrite at $2 in place of the record at $1, unless the record is no
# longer $3, what the rewrite was made from: another hook replaced it (the newer
# state is the one to keep, so the caller makes the rewrite again from it) or
# the session ended (it stays ended). The check is a builtin read right before
# the rename, so the window between them is the rename alone. Returns 1 when
# the record changed, 2 when it is gone; the rewrite is removed either way.
replace_record() {
  local was="$3"
  if ! read_record "$1"; then rm -f "$2"; return 2; fi
  if [ "$REC" != "$was" ]; then rm -f "$2"; return 1; fi
  mv -f "$2" "$1" 2>/dev/null || { rm -f "$2"; return 2; }
}

# SubagentStart / SubagentStop: the record exactly as the last hook left it,
# with `subagents` (and `updated_at`) brought up to date. Line by line, since
# every record this script writes has one field a line; a record from an older
# helper gets the field added above `updated_at`. Made from the record as read,
# never from the file a second time, and re-made if another hook replaced the
# record meanwhile, so the newer state is the one kept; never put back once the
# session's end has taken it (see `replace_record`). With no record yet (the
# hook installed mid-session), a fresh one: a subagent starting is Claude
# working.
rewrite_subagents() {
  local sf="$SESSION_DIR/${SESSION_ID:-unknown}.json" tmp ts line rec seen n=0 rc
  if [ ! -f "$sf" ]; then
    write_status "working" ""
    return 0
  fi
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp="$sf.tmp.$$"
  while :; do
    [ ! -e "$tmp" ] || rm -f "$tmp"
    read_record "$sf" || return 0
    rec="$REC"
    subagents_json
    seen="$SA_JSON"
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *'"subagents":'*) ;;
        *'"updated_at":'*) printf '  "subagents": %s,\n  "updated_at": "%s"\n' "$SA_JSON" "$ts" ;;
        *) printf '%s\n' "$line" ;;
      esac
    done <<< "${rec%$'\n'}" > "$tmp"
    n=$((n + 1))
    rc=0
    replace_record "$sf" "$tmp" "$rec" || rc=$?
    [ "$rc" != 2 ] || return 0
    if [ "$rc" = 1 ]; then
      [ "$n" -lt 3 ] && continue
      return 0
    fi
    [ "$n" -lt 3 ] || break
    subagents_json
    [ "$SA_JSON" != "$seen" ] || break
  done
}

# PermissionDenied: the record as the last hook left it, with `blocked` (and
# `updated_at`) brought up to date and the blocked call no longer running. Its
# PreToolUse wrote it as the tool in progress, and no PostToolUse follows a
# denial: left alone, the face would say "Running rm" for a command that never
# ran. So when the record's tool and target are the blocked call's, they go and
# `tool_active` goes false; when they're another call's (one in parallel, an
# approval waiting), they're left alone. The state stays: Claude Code carries
# the turn on.
# Line by line from the record as read, like `rewrite_subagents`, and never
# put back once the session's end has taken it; with no record yet, a fresh
# one, since a call was just made.
rewrite_blocked() {
  local sf="$SESSION_DIR/${SESSION_ID:-unknown}.json" tmp ts line rec ours n=0 rc
  blocked_json
  if [ ! -f "$sf" ]; then
    ACTION=""; TARGET=""
    write_status "working" ""
    return 0
  fi
  tmp="$sf.tmp.$$"
  while :; do
    [ ! -e "$tmp" ] || rm -f "$tmp"
    read_record "$sf" || return 0
    rec="$REC"
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ours=0
    case "$rec" in
      *$'\n'"  \"action\": \"$ACTION\","$'\n'*)
        case "$rec" in *$'\n'"  \"target\": \"$TARGET\","$'\n'*) ours=1 ;; esac ;;
    esac
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        '  "blocked":'*) ;;
        '  "tool_active":'*) if [ "$ours" = 1 ]; then printf '  "tool_active": false,\n'; else printf '%s\n' "$line"; fi ;;
        '  "action":'*) if [ "$ours" = 1 ]; then printf '  "action": "",\n'; else printf '%s\n' "$line"; fi ;;
        '  "target":'*) if [ "$ours" = 1 ]; then printf '  "target": "",\n'; else printf '%s\n' "$line"; fi ;;
        '  "updated_at":'*) printf '  "blocked": %s,\n  "updated_at": "%s"\n' "$BL_JSON" "$ts" ;;
        *) printf '%s\n' "$line" ;;
      esac
    done <<< "${rec%$'\n'}" > "$tmp"
    n=$((n + 1))
    rc=0
    replace_record "$sf" "$tmp" "$rec" || rc=$?
    if [ "$rc" = 1 ] && [ "$n" -lt 3 ]; then continue; fi
    break
  done
}


# A value made safe to sit between double quotes in the status file. Only
# for text this script owns outright (the project's directory name): it can
# hold anything a filename can, and one quote would make the whole record
# unreadable. Backslash first, so the escapes added after it stay single.
# Pure bash, then `tr` for the control characters JSON has no short form for.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s" | LC_ALL=C tr -d '\000-\037'
}

# True when Isle is running and will answer from the notch: the marker exists
# and the pid inside it is alive. A crash leaves the marker behind, and a dead
# pid gates *off* — never on. Builtins only (`read`, `kill`), since `ask`
# re-checks this on every tick of its wait.
isle_answering() {
  local pid=""
  [ -f "$ANSWERING_MARKER" ] || return 1
  read -r pid < "$ANSWERING_MARKER" 2>/dev/null || true
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$pid" 2>/dev/null
}

# ---- A request being waited on ----------------------------------------------
#
# While `ask` or `ask-question` blocks, the record holds its request id, and
# the hook takes any write that drops the id to mean the prompt was answered
# somewhere else. So only what does mean that may write over it. Subagents'
# hooks carry the parent's session id (2.1.319), and the main agent runs
# read-only tools in parallel, so one agent's Grep fires PreToolUse and
# PostToolUse while another's approval waits in the record. Left to write,
# it would end the wait: the notch's buttons gone and the island saying
# "working" while Claude Code still waits in the terminal.
#
# What ends a wait without the hook's own answer: the call itself finishing
# (Yes in the terminal: its PostToolUse, or PostToolUseFailure when it ran
# and failed, as a command exiting non-zero does in 2.1.319); the turn ending
# or a new one starting (Stop, StopFailure, the next prompt); the session
# ending. Esc on the terminal's dialog SIGTERMs the hook (its trap takes the
# request file), and a hook killed outright leaves a dead pid: either way
# nothing is waiting any more, and the record is anyone's to write.

# The id of the request this session's record holds while its hook still
# waits, in LIVE_REQ; false when there is none. Builtins only: nearly every
# hook asks.
live_request() {
  local sf="$SESSION_DIR/${SESSION_ID:-unknown}.json" line st="" id="" pid
  LIVE_REQ=""
  [ -f "$sf" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '  "state": "needs_'*) st=1 ;;
      '  "request_id": "'?*'",') id="${line#  \"request_id\": \"}"; id="${id%\",}" ;;
    esac
  done 2>/dev/null < "$sf" || return 1
  [ -n "$st" ] && [ -n "$id" ] || return 1
  case "$id" in *[!A-Za-z0-9_-]*) return 1 ;; esac
  [ -f "$REQUEST_DIR/$id.json" ] || return 1
  pid="${id##*-}"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  LIVE_REQ="$id"
}

RQ_RE_AGENT='"agent_id"[[:space:]]*:[[:space:]]*"([^"]*)"'
RQ_RE_TOOL='"tool_name"[[:space:]]*:[[:space:]]*"([^"]*)"'
# What follows a `"tool_use_id"` key: its value, when it's a plain id.
RQ_RE_USE='^[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]{1,64})"'
RQ_RE_FIRST='"tool_input"[[:space:]]*:[[:space:]]*\{[[:space:]]*("[A-Za-z0-9_]+"[[:space:]]*:[[:space:]]*("([^"\\]|\\.)*"|true|false|null|-?[0-9][0-9.eE+-]*))'

# True when this hook ends the wait on request $1 (see above). A tool's end is
# that call's own: the same tool_use_id for a question (`ask-question` is a
# PreToolUse, which has one); for an approval, whose PermissionRequest has
# none, the same agent (agent_id, or none for the main agent), the same tool
# and the same first field of its input (a Bash call's command, a file's path,
# a URL), as Claude Code wrote it.
ends_request() {
  local req="" head here agent="" ragent="" tool="" use
  case "$CMD:$HOOK_EVENT" in
    set-state:UserPromptSubmit|set-state:Stop) return 0 ;;
    set-state:PostToolUse|set-state:PostToolUseFailure) ;;
    *) return 1 ;;
  esac
  { IFS= read -r -d '' req || [ -n "$req" ]; } 2>/dev/null < "$REQUEST_DIR/$1.json" || return 0
  req="${req:0:65536}"
  head="${req%%\"tool_input\"*}"
  case "$head" in
    *'"hook_event_name":"PreToolUse"'*|*'"hook_event_name": "PreToolUse"'*)
      [[ ${req##*\"tool_use_id\"} =~ $RQ_RE_USE ]] || return 1
      use="${BASH_REMATCH[1]}"
      [[ ${STDIN_JSON##*\"tool_use_id\"} =~ $RQ_RE_USE ]] && [ "${BASH_REMATCH[1]}" = "$use" ]
      return ;;
  esac
  here="${STDIN_JSON%%\"tool_input\"*}"
  [[ $head =~ $RQ_RE_AGENT ]] && ragent="${BASH_REMATCH[1]}"
  [[ $here =~ $RQ_RE_AGENT ]] && agent="${BASH_REMATCH[1]}"
  [ "$agent" = "$ragent" ] || return 1
  [[ $head =~ $RQ_RE_TOOL ]] && tool="${BASH_REMATCH[1]}"
  [ -n "$tool" ] && [ "$tool" = "$ACTION" ] || return 1
  if [[ $req =~ $RQ_RE_FIRST ]]; then
    [[ $STDIN_JSON == *"${BASH_REMATCH[1]}"* ]] || return 1
  fi
  return 0
}

# ---- Usage limits -----------------------------------------------------------
#
# When a claude.ai usage limit ends a turn, StopFailure says only `rate_limit`
# and the words Claude showed: "You've hit your 5-hour limit · resets 6:50pm
# (America/Toronto)". No hook field carries the reset as a number (2.1.319
# sets no `error_details` for it). The transcript does: the failed turn's
# record has `quotaLimits` with `resetsAt` (epoch seconds) and
# `rateLimitType`, and when Claude Code starts its own wait it writes a
# `system` record, "Usage limit reached · continuing automatically at
# 6:50pm". Both are internal, so each is read only for what it plainly says,
# and anything missing stays empty: the island falls back to what it said
# before rather than to a guess. The words are the last resort.
#
# Only `fail` and `notify` come here, and only on a limit, so the forks below
# cost nothing on the hooks that run all the time. ISLE_CLI_NOW (epoch
# seconds) stands in for the clock in the tests.

# The status file's value for $1, for a field this script wrote.
record_field() {
  LC_ALL=C grep -oE "\"$1\": \"[^\"]*\"" "$2" 2>/dev/null | head -n 1 \
    | LC_ALL=C sed -E 's/.*: "([^"]*)"$/\1/'
}

# Epoch seconds for Claude Code's "2026-11-05T05:31:38.143Z"; empty if not one.
iso_epoch() {
  local t="${1%Z}"
  t="${t%%.*}"
  [ -n "$t" ] || return 0
  date -j -u -f '%Y-%m-%dT%H:%M:%S' "$t" +%s 2>/dev/null
}

# `date -r <epoch> <format>` in zone $1 (empty: this Mac's own). An empty TZ
# would mean UTC, not local, so it is left out rather than set empty.
zone_date() {
  if [ -n "$1" ]; then TZ="$1" date -r "$2" "$3" 2>/dev/null
  else date -r "$2" "$3" 2>/dev/null; fi
}

# Epoch seconds for the wall-clock time $2 (Y-m-d) $3:$4 in zone $1.
zone_epoch() {
  if [ -n "$1" ]; then TZ="$1" date -j -f '%Y-%m-%d %H:%M:%S' "$2 $3:$4:00" +%s 2>/dev/null
  else date -j -f '%Y-%m-%d %H:%M:%S' "$2 $3:$4:00" +%s 2>/dev/null; fi
}

# A reset that is a real one: from a day ago (just reset) to 40 days out.
# Anything else is a number that happens to look like a time.
plausible_reset() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge $(($2 - 86400)) ] && [ "$1" -le $(($2 + 40 * 86400)) ]
}

# The window and the reset from the words Claude showed, into TEXT_KIND and
# TEXT_RESET. "resets 6:50pm" is the next time that clock reads 6:50pm in
# the zone named after it, so a limit hit at 11pm that resets at 1:20am
# resets tomorrow; within five minutes past counts as now, since the words
# were written a moment before this runs. "resets Nov 9 at 8pm" (more than a
# day out; with the year when it isn't this one) is that moment. A zone Isle
# can't find leaves both empty; no zone at all is this Mac's, which is the
# one Claude Code formats in. $1 = the text, $2 = now.
limit_from_text() {
  local t="$1" now="$2" re when zone h m ap mon day year M today noon next cand
  TEXT_KIND=""; TEXT_RESET=""
  case "$t" in
    *"hit your 5-hour limit"*|*"hit your session limit"*) TEXT_KIND="five_hour" ;;
    *"hit your weekly limit"*) TEXT_KIND="seven_day" ;;
    *"hit your Opus limit"*) TEXT_KIND="seven_day_opus" ;;
    *"hit your Sonnet limit"*) TEXT_KIND="seven_day_sonnet" ;;
  esac
  re='resets ([A-Za-z0-9:, ]*[0-9](am|pm))( \(([A-Za-z0-9_+/-]+)\))?'
  [[ $t =~ $re ]] || return 0
  when="${BASH_REMATCH[1]}"; zone="${BASH_REMATCH[4]}"
  if [ -n "$zone" ]; then
    case "$zone" in *..*|/*) return 0 ;; esac
    [ -f "/usr/share/zoneinfo/$zone" ] || return 0
  fi
  re='^([0-9]{1,2})(:([0-9]{2}))?(am|pm)$'
  if [[ $when =~ $re ]]; then
    h="${BASH_REMATCH[1]}"; m="${BASH_REMATCH[3]:-00}"; ap="${BASH_REMATCH[4]}"
  else
    re='^([A-Z][a-z]{2}) ([0-9]{1,2})(, ([0-9]{4}))?(,| at) ([0-9]{1,2})(:([0-9]{2}))?(am|pm)$'
    [[ $when =~ $re ]] || return 0
    mon="${BASH_REMATCH[1]}"; day="${BASH_REMATCH[2]}"; year="${BASH_REMATCH[4]}"
    h="${BASH_REMATCH[6]}"; m="${BASH_REMATCH[8]:-00}"; ap="${BASH_REMATCH[9]}"
    case "$mon" in
      Jan) M=01 ;; Feb) M=02 ;; Mar) M=03 ;; Apr) M=04 ;; May) M=05 ;; Jun) M=06 ;;
      Jul) M=07 ;; Aug) M=08 ;; Sep) M=09 ;; Oct) M=10 ;; Nov) M=11 ;; Dec) M=12 ;;
      *) return 0 ;;
    esac
  fi
  h=$((10#$h))
  if [ "$h" -lt 1 ] || [ "$h" -gt 12 ]; then return 0; fi
  if [ "$ap" = am ]; then
    if [ "$h" -eq 12 ]; then h=0; fi
  elif [ "$h" -lt 12 ]; then
    h=$((h + 12))
  fi
  if [ -n "$mon" ]; then
    [ -n "$year" ] || year="$(zone_date "$zone" "$now" +%Y)"
    cand="$(zone_epoch "$zone" "$year-$M-$(printf '%02d' $((10#$day)))" "$h" "$m")"
  else
    today="$(zone_date "$zone" "$now" +%Y-%m-%d)"
    cand="$(zone_epoch "$zone" "$today" "$h" "$m")"
    if [ -n "$cand" ] && [ "$cand" -lt $((now - 300)) ]; then
      # Tomorrow's date from today's noon, so a DST change can't skip a day.
      noon="$(zone_epoch "$zone" "$today" 12 00)"
      next="$(zone_date "$zone" $((noon + 86400)) +%Y-%m-%d)"
      cand="$(zone_epoch "$zone" "$next" "$h" "$m")"
    fi
  fi
  plausible_reset "$cand" "$now" || return 0
  TEXT_RESET="$cand"
}

# The limit from the transcript at $1, into TR_RESET, TR_KIND and TR_AUTO
# (1 when Claude Code said it will continue on its own). Only a record from
# the last two minutes is this hit; an older one is a different window.
#
# Claude Code writes the transcript on its own clock, and its "continuing
# automatically" record lands a few milliseconds either side of the failed
# turn's, so this looks again for up to two seconds, until it has that record
# or the turn's closing `turn_duration`. Nothing waits on StopFailure. A reset
# more than a day out is never waited for by Claude Code, so that's settled
# at once. $2 = now.
limit_from_transcript() {
  local tp="$1" now="$2" i=0 lines rec ts ets q line its
  TR_RESET=""; TR_KIND=""; TR_AUTO=""
  [ -n "$tp" ] && [ -f "$tp" ] || return 0
  while [ "$i" -lt 20 ]; do
    [ "$i" -eq 0 ] || sleep 0.1
    i=$((i + 1))
    lines="$(tail -c 2000000 "$tp" 2>/dev/null | LC_ALL=C grep -E \
      '"apiError":"usage_limit_reached"|"subtype":"(informational|turn_duration)"' 2>/dev/null)"
    rec="$(printf '%s\n' "$lines" | LC_ALL=C grep -F '"apiError":"usage_limit_reached"' | tail -n 1)"
    [ -n "$rec" ] || continue
    ts="$(printf '%s' "$rec" | LC_ALL=C grep -oE '"timestamp":"[^"]*"' | head -n 1 | LC_ALL=C sed -E 's/.*:"([^"]*)"$/\1/')"
    ets="$(iso_epoch "$ts")"
    [ -n "$ets" ] || continue
    if [ $((now - ets)) -gt 120 ] || [ $((ets - now)) -gt 60 ]; then continue; fi
    q="$(printf '%s' "$rec" | LC_ALL=C grep -oE '"quotaLimits":\{[^}]*\}' | head -n 1)"
    [ -n "$q" ] || q="$(printf '%s' "$rec" | LC_ALL=C grep -oE '"rate_limit_info":\{[^}]*\}' | head -n 1)"
    TR_RESET="$(printf '%s' "$q" | LC_ALL=C grep -oE '"resetsAt":[0-9]+' | head -n 1 | LC_ALL=C sed 's/.*://')"
    plausible_reset "$TR_RESET" "$now" || TR_RESET=""
    TR_KIND="$(printf '%s' "$q" | LC_ALL=C grep -oE '"rateLimitType":"[a-z0-9_]+"' | head -n 1 | LC_ALL=C sed -E 's/.*:"([^"]*)"$/\1/')"
    while IFS= read -r line; do
      case "$line" in
        *'"subtype":"informational"'*'Usage limit reached'*'continuing automatically'*) ;;
        *) continue ;;
      esac
      ts="$(printf '%s' "$line" | LC_ALL=C grep -oE '"timestamp":"[^"]*"' | head -n 1 | LC_ALL=C sed -E 's/.*:"([^"]*)"$/\1/')"
      its="$(iso_epoch "$ts")"
      [ -n "$its" ] || continue
      if [ $((its - ets)) -le 10 ] && [ $((ets - its)) -le 10 ]; then TR_AUTO=1; return 0; fi
    done <<< "$lines"
    if [ -n "$TR_RESET" ] && [ $((TR_RESET - now)) -gt 86400 ]; then return 0; fi
    while IFS= read -r line; do
      case "$line" in *'"subtype":"turn_duration"'*) ;; *) continue ;; esac
      ts="$(printf '%s' "$line" | LC_ALL=C grep -oE '"timestamp":"[^"]*"' | head -n 1 | LC_ALL=C sed -E 's/.*:"([^"]*)"$/\1/')"
      its="$(iso_epoch "$ts")"
      if [ -n "$its" ] && [ "$its" -ge "$ets" ]; then return 0; fi
    done <<< "$lines"
  done
  return 0
}

# ---- A Bash command's program -----------------------------------------------
#
# The status file's target is cut to 48 characters, which a `cd <long path>
# && xcodebuild …` spends on the path, so for Bash (and Monitor) the target is
# the program's name, read from the whole command here: the rules of
# ClaudeActivity.program(ofCommand:) in the app, so the two can't disagree.
# Past `NAME=value` assignments and shell keywords, through `env` / `sudo` /
# `time` / `nohup` / `command` / `exec` (and their options), past whole `cd` /
# `pushd` / `popd` / `export` / `unset` / `set` segments, to the first word of
# the first segment left, de-pathed. Segments end at ; & | ( ) and newlines;
# a `#` before a word starts a comment; quotes are taken off. The word must be
# a plain name, or the target is empty and the app says "Running a command".
#
# Only the start of the command is read (4 KB), and it stops at the first
# segment that names something, so a long heredoc costs no more than a short
# command. Builtins only.

BP_PLAIN=$'^[^ \t;&|()\\\\\'"#\n\r]+'
BP_ASSIGN='^[A-Za-z_][A-Za-z0-9_]*='
BP_NAME='^[A-Za-z0-9._+@~-]+$'
BP_PATH='^[A-Za-z0-9._+@/~ -]+$'
# A command whose closing quote is past what was read.
BP_RE_OPEN='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)'

# The program for segment BP_W[0..BP_N) (BP_E: whether each word ended), into
# BP_OUT. Returns 0 when the segment decides it (a name, or none), 1 when it
# only set things up and the next segment should be read.
bp_segment() {
  local k=0 w first takes name
  while [ "$k" -lt "$BP_N" ]; do
    w="${BP_W[k]}"
    case "$w" in
      '!'|'{'|'}'|if|then|elif|else|while|until|do) k=$((k + 1)); continue ;;
    esac
    if [[ $w =~ $BP_ASSIGN ]]; then k=$((k + 1)); continue; fi
    case "$w" in
      env|sudo|time|nohup|command|exec)
        # `command -v name` only looks the name up.
        if [ "$w" = command ] && [ $((k + 1)) -lt "$BP_N" ]; then
          case "${BP_W[k+1]}" in -v|-V) break ;; esac
        fi
        first="$w"; k=$((k + 1))
        while [ "$k" -lt "$BP_N" ]; do
          w="${BP_W[k]}"
          if [ "${w:0:1}" = "-" ] || [[ $w =~ $BP_ASSIGN ]]; then
            takes=1
            if [ "$first" = sudo ]; then
              case "$w" in -u|-g|-C|-h|-p|-U) takes=2 ;; esac
            fi
            k=$((k + takes))
          else
            break
          fi
        done
        continue ;;
    esac
    break
  done
  [ "$k" -lt "$BP_N" ] || return 1
  w="${BP_W[k]}"
  case "$w" in cd|pushd|popd|export|unset|set) return 1 ;; esac
  if [ "${BP_E[k]}" = 0 ] && [ "$BP_CUT" = 1 ]; then return 0; fi
  # A path may have spaces in its folders (it was quoted); the name may not.
  [[ $w =~ $BP_PATH ]] || return 0
  name="$w"
  while [ "${#name}" -gt 1 ] && [ "${name%/}" != "$name" ]; do name="${name%/}"; done
  [ "$name" = "/" ] || name="${name##*/}"
  case "$name" in ''|.|..|/|'~'|-*) return 0 ;; esac
  [[ $name =~ $BP_NAME ]] || return 0
  BP_OUT="$name"
  BP_K="$k"
  return 0
}

# The program the command $1 (unescaped) runs, into BP_OUT; empty when it
# can't be named. $2 = 1 when $1 is only the start of the command. Its word is
# BP_W[BP_K], the rest of its segment after it.
bash_program() {
  local LC_ALL=C
  local t="$1" i=0 n c q="" esc=0 com=0 word="" inw=0
  BP_OUT=""; BP_N=0; BP_K=0; BP_CUT="${2:-0}"
  BP_W=(); BP_E=()
  n=${#t}
  while [ "$i" -lt "$n" ]; do
    c="${t:i:1}"
    if [ "$com" = 1 ]; then
      if [ "$c" = $'\n' ]; then
        com=0
        if [ "$BP_N" -gt 0 ]; then bp_segment && return 0; BP_N=0; fi
        i=$((i + 1))
      else
        # Straight to the end of the comment's line.
        c="${t:i}"; c="${c%%$'\n'*}"; i=$((i + ${#c}))
      fi
      continue
    fi
    if [ "$esc" = 1 ]; then
      word="$word$c"; inw=1; esc=0; i=$((i + 1)); continue
    fi
    if [ -n "$q" ]; then
      # Inside "…", a backslash keeps the quote or backslash after it.
      if [ "$q" = '"' ] && [ "$c" = '\' ] && [ $((i + 1)) -lt "$n" ]; then
        case "${t:i+1:1}" in
          '"'|'\'|'$'|'`') word="$word${t:i+1:1}"; i=$((i + 2)); continue ;;
        esac
      fi
      if [ "$c" = "$q" ]; then q=""; else word="$word$c"; fi
      i=$((i + 1)); continue
    fi
    case "$c" in
      '\') esc=1 ;;
      "'"|'"') q="$c"; inw=1 ;;
      ' '|$'\t')
        if [ "$inw" = 1 ]; then BP_W[BP_N]="$word"; BP_E[BP_N]=1; BP_N=$((BP_N + 1)); fi
        word=""; inw=0 ;;
      ';'|'&'|'|'|'('|')'|$'\n'|$'\r')
        if [ "$inw" = 1 ]; then BP_W[BP_N]="$word"; BP_E[BP_N]=1; BP_N=$((BP_N + 1)); fi
        word=""; inw=0
        if [ "$BP_N" -gt 0 ]; then bp_segment && return 0; BP_N=0; fi ;;
      '#')
        if [ "$inw" = 1 ]; then word="$word#"; else com=1; fi ;;
      *)
        if [[ ${t:i} =~ $BP_PLAIN ]]; then
          word="$word${BASH_REMATCH[0]}"; inw=1; i=$((i + ${#BASH_REMATCH[0]})); continue
        fi
        word="$word$c"; inw=1 ;;
    esac
    i=$((i + 1))
  done
  # The last word ran into the end of what was read.
  if [ "$inw" = 1 ]; then BP_W[BP_N]="$word"; BP_E[BP_N]=0; BP_N=$((BP_N + 1)); fi
  if [ "$BP_N" -gt 0 ]; then bp_segment; fi
  return 0
}

# ---- What a turn left behind (Milestone 20) ---------------------------------
#
# Stop carries, after `last_assistant_message`, two arrays of flat objects
# (2.1.319): `background_tasks` — `id`, `type` (shell, subagent, monitor,
# workflow, MCP task, teammate, cloud session, …), `status` (running or
# pending), `description`, and `command` for a shell, `agent_type` for an
# agent, `server` and `tool` for a monitor or an MCP task, `name` for a
# workflow — and `session_crons` — `id`, `schedule` (five cron fields, this
# Mac's time), `recurring`, `prompt`. Read here without jq: `,"` can't occur
# inside a JSON string (a quote in one is always escaped), so the first
# `,"background_tasks":[` is the key itself, and the arrays after it are walked
# value by value. Anything that isn't the flat shape stops the walk, and the
# turn is said to have left nothing: the island says less, never more.
#
# A shell is kept as its program, read from the whole command the way the
# target is, and the program's words up to the end of its own command (a
# redirection, `&&`, `|`): `cd web && npm run dev > log` is "npm run dev". At
# most 48 characters, on a whole word; `cut` says there was more. An agent is
# its type, a monitor or an MCP task its tool, a workflow its name. Claude
# Code's own housekeeping (dream, auto-mode scan, memory import) isn't kept.
# Eight tasks and four wake-ups at most; `more` and `more_crons` count the rest.

LT_RE_WS='^[[:space:]]+'
LT_RE_KEY='^"([A-Za-z_]{1,40})"[[:space:]]*:[[:space:]]*'
LT_RE_STR='^"(([^"\\]|\\.)*)"'
LT_RE_LIT='^(true|false|null|-?[0-9][0-9.eE+-]{0,30})'
LT_RE_ARRAY='^,[[:space:]]*"(background_tasks|session_crons)"[[:space:]]*:[[:space:]]*\['

lt_ws() {
  if [[ $LT_REST =~ $LT_RE_WS ]]; then LT_REST="${LT_REST:${#BASH_REMATCH[0]}}"; fi
  return 0
}

# One array of flat objects from LT_REST (which starts just past its `[`),
# each handed to $1 with its fields in LO_*; LT_REST is left past the `]`.
# Returns 1 on anything else.
lt_array() {
  local handler="$1" key val
  lt_ws
  if [ "${LT_REST:0:1}" = "]" ]; then LT_REST="${LT_REST:1}"; return 0; fi
  while :; do
    lt_ws
    [ "${LT_REST:0:1}" = "{" ] || return 1
    LT_REST="${LT_REST:1}"
    LO_ID=""; LO_TYPE=""; LO_STATUS=""; LO_COMMAND=""; LO_AGENT=""; LO_TOOL=""; LO_SERVER=""
    LO_NAME=""; LO_SCHEDULE=""; LO_RECURRING=""
    lt_ws
    if [ "${LT_REST:0:1}" = "}" ]; then
      LT_REST="${LT_REST:1}"
    else
      while :; do
        lt_ws
        [[ $LT_REST =~ $LT_RE_KEY ]] || return 1
        key="${BASH_REMATCH[1]}"; LT_REST="${LT_REST:${#BASH_REMATCH[0]}}"
        if [[ $LT_REST =~ $LT_RE_STR ]]; then val="${BASH_REMATCH[1]}"
        elif [[ $LT_REST =~ $LT_RE_LIT ]]; then val="${BASH_REMATCH[1]}"
        else return 1
        fi
        LT_REST="${LT_REST:${#BASH_REMATCH[0]}}"
        case "$key" in
          id) LO_ID="$val" ;;
          type) LO_TYPE="$val" ;;
          status) LO_STATUS="$val" ;;
          command) LO_COMMAND="$val" ;;
          agent_type) LO_AGENT="$val" ;;
          tool) LO_TOOL="$val" ;;
          server) LO_SERVER="$val" ;;
          name) LO_NAME="$val" ;;
          schedule) LO_SCHEDULE="$val" ;;
          recurring) LO_RECURRING="$val" ;;
        esac
        lt_ws
        case "${LT_REST:0:1}" in
          ,) LT_REST="${LT_REST:1}" ;;
          '}') LT_REST="${LT_REST:1}"; break ;;
          *) return 1 ;;
        esac
      done
    fi
    "$handler"
    lt_ws
    case "${LT_REST:0:1}" in
      ,) LT_REST="${LT_REST:1}" ;;
      ']') LT_REST="${LT_REST:1}"; return 0 ;;
      *) return 1 ;;
    esac
  done
}

# A name from the payload made safe to sit in the record: the characters a
# type, a tool or a workflow's name has, 64 at most. Escapes lose their
# backslash and are kept as letters, as `agent_type` is for the subagents.
lt_safe() {
  local s="${1//[^A-Za-z0-9 _.:-]/}"
  LT_SAFE="${s:0:64}"
}

# A shell's words, from `bash_program`'s: the program and what follows it in
# its own command, up to a redirection, into LT_RUN; LT_CUT=true when words
# were left off for length or the read stopped inside them.
lt_run() {
  local i w
  LT_RUN="$BP_OUT"; LT_CUT=false
  i=$((BP_K + 1))
  while [ "$i" -lt "$BP_N" ]; do
    w="${BP_W[i]}"
    i=$((i + 1))
    case "$w" in
      '>'*|'<'*|[0-9]'>'*|[0-9]'<'*|'&>'*) break ;;
    esac
    if [ "${BP_E[i-1]}" = 0 ] && [ "$BP_CUT" = 1 ]; then LT_CUT=true; break; fi
    w="${w//[[:cntrl:]]/ }"
    [ -n "$w" ] || continue
    if [ $((${#LT_RUN} + 1 + ${#w})) -gt 48 ]; then LT_CUT=true; break; fi
    LT_RUN="$LT_RUN $w"
  done
  LT_RUN="${LT_RUN//\\/\\\\}"
  LT_RUN="${LT_RUN//\"/\\\"}"
}

lt_task() {
  local type name run="" cut=false raw
  case "$LO_STATUS" in running|pending|'') ;; *) return 0 ;; esac
  lt_safe "$LO_TYPE"; type="$LT_SAFE"
  # A subagent still running is one the count keeps (see `stop_prune_agents`),
  # whether or not the line below has room to name it.
  # Cut as SubagentStart cut the file name, so the two agree.
  if [ "$type" = subagent ]; then
    local aid="${LO_ID//[^A-Za-z0-9_-]/}"
    LT_AGENT_IDS="$LT_AGENT_IDS${aid:0:64} "
  fi
  case "$type" in
    dream|'auto-mode scan'|'memory import'|'memory save') return 0 ;;
  esac
  name=""
  case "$type" in
    shell)
      raw="${LO_COMMAND:0:4096}"
      # Claude Code's own mark on a command it clipped at 1000 characters.
      local clipped=0
      case "$raw" in *' [+'*' chars]') raw="${raw% \[+*}"; clipped=1 ;; esac
      [ "${#LO_COMMAND}" -gt 4096 ] && clipped=1
      guard_unescape "$raw"
      bash_program "$GUARD_TEXT" "$clipped" || true
      if [ -n "$BP_OUT" ]; then
        name="$BP_OUT"
        lt_run
        run="$LT_RUN"; cut="$LT_CUT"
      fi
      ;;
    subagent) lt_safe "$LO_AGENT"; name="$LT_SAFE" ;;
    monitor|'MCP task') lt_safe "${LO_TOOL:-$LO_SERVER}"; name="$LT_SAFE" ;;
    workflow) lt_safe "$LO_NAME"; name="$LT_SAFE" ;;
  esac
  if [ "$LT_KEPT" -ge 8 ]; then LT_MORE=$((LT_MORE + 1)); return 0; fi
  LT_KEPT=$((LT_KEPT + 1))
  LT_TASKS="$LT_TASKS${LT_TASKS:+, }{\"type\": \"$type\", \"name\": \"$name\", \"run\": \"$run\", \"cut\": $cut}"
}

lt_cron() {
  local schedule recurring=false drop='[^0-9A-Za-z*/,? -]'
  schedule="${LO_SCHEDULE//$drop/}"
  schedule="${schedule:0:64}"
  [ "$LO_RECURRING" = true ] && recurring=true
  if [ "$LT_CRONS_KEPT" -ge 4 ]; then LT_MORE_CRONS=$((LT_MORE_CRONS + 1)); return 0; fi
  LT_CRONS_KEPT=$((LT_CRONS_KEPT + 1))
  LT_CRONS="$LT_CRONS${LT_CRONS:+, }{\"schedule\": \"$schedule\", \"recurring\": $recurring}"
}

# At Stop, the session's counted agents that aren't among the turn's
# `background_tasks` (LT_AGENT_IDS, " id id "): their turn is over and they
# didn't outlive it. That is how an agent stopped by Esc goes: Claude Code
# 2.1.319 fires no SubagentStop for it (measured), and without this it would
# be counted until the session ended. A background agent is listed by the
# same id its SubagentStart carried (also measured), so it stays until its
# own stop.
stop_prune_agents() {
  local id="${SESSION_ID//[^A-Za-z0-9_-]/}" d f
  [ -n "$id" ] || return 0
  d="$AGENT_DIR/$id"
  [ -d "$d" ] || return 0
  for f in "$d"/*; do
    [ -e "$f" ] || continue
    f="${f##*/}"
    case "$f" in *.*) continue ;; esac
    case "$LT_AGENT_IDS" in *" $f "*) ;; *) rm -f "$d/$f" ;; esac
  done
  rmdir "$d" 2>/dev/null || true
  return 0
}

# Stop: what the turn left, kept at left/<session>.json, or nothing kept. A
# payload with neither array, or both empty (nearly every Stop), costs two
# pattern tests.
stop_leftovers() {
  local id="${SESSION_ID//[^A-Za-z0-9_-]/}" f out arr ok=1 walked=0
  [ -n "$id" ] || return 0
  f="$LEFT_DIR/$id.json"
  LT_AGENT_IDS=" "
  case "$STDIN_JSON" in
    *'"background_tasks":[{'*|*'"session_crons":[{'*|*'"background_tasks": [{'*|*'"session_crons": [{'*) ;;
    *)
      rm -f "$f"
      # Nothing left running at all, said outright: no agent is. No list at
      # all (a Claude Code from before it, or a turn that didn't say): the
      # turn's end lets them go, as before v17, rather than count an agent
      # for turns on end that may be long gone. `"background_tasks"` right up
      # to its closing quote can't occur inside a string, where quotes are
      # escaped. Anything else unread keeps the count.
      if [[ $STDIN_JSON =~ \"background_tasks\"[[:space:]]*:[[:space:]]*\[[[:space:]]*\] ]] \
         || [[ $STDIN_JSON != *'"background_tasks"'* ]]; then
        stop_prune_agents
      fi
      return 0 ;;
  esac
  set +eu
  local LC_ALL=C
  LT_TASKS=""; LT_CRONS=""; LT_KEPT=0; LT_MORE=0; LT_CRONS_KEPT=0; LT_MORE_CRONS=0
  LT_REST="$(printf '%s' "$STDIN_JSON" | LC_ALL=C grep -oE -e ',[[:space:]]*"(background_tasks|session_crons)"[[:space:]]*:[[:space:]]*\[.*' \
    | head -c 262144)"
  while [[ $LT_REST =~ $LT_RE_ARRAY ]]; do
    arr="${BASH_REMATCH[1]}"
    LT_REST="${LT_REST:${#BASH_REMATCH[0]}}"
    if [ "$arr" = background_tasks ]; then
      lt_array lt_task || { ok=0; break; }
      walked=1
    else
      lt_array lt_cron || { ok=0; break; }
    fi
    lt_ws
  done
  set -eu
  # Only from a list read to its end: one that stopped the walk says nothing
  # about which agents still run, so the count stays as it was.
  if [ "$ok" = 1 ] && [ "$walked" = 1 ]; then stop_prune_agents; fi
  if [ "$ok" = 0 ] || { [ "$LT_KEPT" = 0 ] && [ "$LT_MORE" = 0 ] && [ "$LT_CRONS_KEPT" = 0 ]; }; then
    rm -f "$f"; return 0
  fi
  out="{\"tasks\": [$LT_TASKS], \"more\": $LT_MORE, \"crons\": [$LT_CRONS], \"more_crons\": $LT_MORE_CRONS, \"at\": \"$TIMESTAMP\"}"
  # A word that isn't valid UTF-8 drops the line rather than the record.
  case "$out" in
    *[![:print:]]*)
      if ! printf '%s' "$out" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then rm -f "$f"; return 0; fi ;;
  esac
  mkdir -p "$LEFT_DIR" 2>/dev/null || true
  printf '%s\n' "$out" > "$f.tmp.$$" 2>/dev/null && mv -f "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$"
  return 0
}

# ---- Guarded commands -------------------------------------------------------
#
# A speed bump for honest mistakes, not a sandbox. The command is read the way
# a shell splits it: into words, with the quotes taken off, and into simple
# commands at `;` `&&` `||` `|` `&`, newlines and parentheses — so
# `cd x && git push` and `git "push"` are both caught, and `echo "git push"`
# isn't. `$(…)` and backticks are commands of their own; a script handed to
# `bash -c` / `sh -c` / `eval`, or a heredoc fed to a shell, is read as one
# too; `env FOO=1`, `sudo`, `xargs`, `nohup`, `timeout` and the like are seen
# through. What it can't see it doesn't pretend to: a variable or an alias in
# command position, a script file, a string built at run time.
#
# A pattern is words: the program (by name, so /usr/bin/git is git), then the
# subcommand words in order, then flags anywhere. Between the program and its
# subcommand an option's value may stand (`git -C dir push`). A short-flag
# cluster matches letters in any grouping (`rm -rf` is `rm -fr`, `rm -r -f`),
# exactly as written: `-R` is not `-r`. Everything else is exact.
#
# Builtins only, and bash 3.2: a guarded hook runs on every Bash call.

GUARD_US=$'\037'          # between the words of a simple command
GUARD_RS=$'\036'          # between pending heredocs
GUARD_UNKNOWN=$'\034'     # stands in for a $(…) or ${…}: never equal to a word
GUARD_NL=$'\n'
GUARD_TAB=$'\t'
# Longer than this (in characters, once unescaped), a command isn't read
# word by word: reading 16 KB takes about a second, and the hook has ten.
GUARD_PARSE_MAX=16384
# A run of characters with no meaning to the shell, outside and inside "…".
GUARD_RE_PLAIN="^[^ $GUARD_TAB;&|()<>\`'\"\\\$#]+"
GUARD_RE_DQ="^[^\"\\\$\`]+"
GUARD_RE_ASSIGN='^[A-Za-z_][A-Za-z0-9_]*\+?='
GUARD_RE_COMMAND='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
GUARD_RE_SESSION='"session_id"[[:space:]]*:[[:space:]]*"([^"]*)"'

# $1 with its JSON escapes undone, into GUARD_TEXT. A `\u` escape is a control
# character or half a surrogate pair (Claude Code writes everything else raw):
# a space, which can't join two words into one that matters.
#
# Split at the backslashes in one go, so the cost grows with the length: a
# loop of ${rest#*\\} rescans the rest for every escape, and a big heredoc
# has thousands. Each piece after the first starts with the escaped
# character; an empty piece is an escaped backslash, which also takes the
# next piece whole. The trailing Z keeps a final empty piece from being lost.
guard_unescape() {
  local p i=1 n k=1
  local -a parts out
  local IFS='\'
  set -f
  parts=($1Z)
  set +f
  n=${#parts[@]}
  # Pieces go into an array and are joined once: appending to one growing
  # string copies it every time.
  out[0]="${parts[0]}"
  while [ "$i" -lt "$n" ]; do
    p="${parts[i]}"; i=$((i + 1))
    if [ -z "$p" ]; then
      out[k]="\\"; k=$((k + 1))
      [ "$i" -lt "$n" ] && { out[k]="${parts[i]}"; k=$((k + 1)); i=$((i + 1)); }
      continue
    fi
    case "${p:0:1}" in
      n) out[k]="$GUARD_NL${p:1}" ;;
      t) out[k]="$GUARD_TAB${p:1}" ;;
      r|b|f) out[k]=" ${p:1}" ;;
      u) out[k]=" ${p:5}" ;;
      *) out[k]="$p" ;;
    esac
    k=$((k + 1))
  done
  IFS=""
  GUARD_TEXT="${out[*]}"
  GUARD_TEXT="${GUARD_TEXT%Z}"
}

# The text with every quote, backslash and newline taken out, into
# GUARD_FLAT: each word of a command is still in it whole, however it was
# quoted or continued, so a pattern with a word missing from it can't match.
# By splitting, like the unescape: ${x//[\"\'\\]/} takes seconds on 10 KB.
guard_flatten() {
  local -a parts
  local IFS=$'"\'\\\n'
  set -f
  parts=($1)
  set +f
  IFS=""
  GUARD_FLAT="${parts[*]}"
}

# The splitter's helpers share its locals (bash scopes dynamically).
#
# Ends the word being read: onto the command, or — straight after a
# redirection — dropped as its target, or kept as a heredoc's delimiter.
guard_word() {
  local r w e=0
  [ "$inword" = 1 ] || return 0
  if [ "$drop" = 2 ]; then
    # A heredoc is read as commands only when a shell is what reads it.
    r="$cur"
    while [ -n "$r" ]; do
      w="${r%%$GUARD_US*}"; r="${r#*$GUARD_US}"
      case "${w##*/}" in bash|sh|zsh|dash|ksh|fish|eval|source|.) e=1 ;; esac
    done
    hd="$hd$word$GUARD_US$strip$GUARD_US$e$GUARD_RS"
  elif [ "$drop" = 0 ]; then
    cur="$cur$word$GUARD_US"
  fi
  drop=0; word=""; inword=0
}

# Ends the simple command being read.
guard_end() {
  guard_word
  if [ -n "$cur" ]; then GUARD_CMDS+=("$cur"); cur=""; fi
}

# Opens `$(`, a backtick, `<(` or a subshell: what's inside is commands of its
# own, and the word around a substitution goes on after it as an unknown.
# $1 = p (parentheses) or b (backtick); $2 = 1 inside a word.
guard_open() {
  if [ "$2" = 1 ]; then
    word="$word$GUARD_UNKNOWN"; inword=1
  else
    guard_end
  fi
  scur[sp]="$cur"; sword[sp]="$word"; sinw[sp]="$inword"; sdrop[sp]="$drop"; sp=$((sp + 1))
  ctx="$ctx$1"; cur=""; word=""; inword=0; drop=0
}

guard_close() {
  guard_end
  sp=$((sp - 1))
  cur="${scur[sp]}"; word="${sword[sp]}"; inword="${sinw[sp]}"; drop="${sdrop[sp]}"
  ctx="${ctx%?}"
}

# Splits shell text into simple commands, appended to GUARD_CMDS as their
# words joined by \037. Line by line, so a long heredoc or script costs time
# in proportion to its length; quotes and substitutions carry across lines.
guard_split() {
  local line i n c d top word="" inword=0 cur="" drop=0 op strip=0 ctx="" sp=0 hd=""
  local entry delim e t body cont
  local -a scur sword sinw sdrop
  while IFS= read -r line || [ -n "$line" ]; do
    # Bodies of heredocs opened on the line before: data, unless a shell reads them.
    if [ -n "$hd" ]; then
      entry="${hd%%$GUARD_RS*}"
      delim="${entry%%$GUARD_US*}"; e="${entry#*$GUARD_US}"; strip="${e%%$GUARD_US*}"; e="${e#*$GUARD_US}"
      t="$line"
      if [ "$strip" = 1 ]; then while [ "${t:0:1}" = "$GUARD_TAB" ]; do t="${t:1}"; done; fi
      if [ "$t" = "$delim" ]; then
        hd="${hd#*$GUARD_RS}"
        [ "$e" = 1 ] && [ -n "$body" ] && GUARD_SCRIPTS+=("$body")
        body=""
      else
        body="$body$line$GUARD_NL"
      fi
      continue
    fi
    body=""
    i=0; n=${#line}; cont=0
    while [ "$i" -lt "$n" ]; do
      c="${line:i:1}"
      top="${ctx:${#ctx}-1}"
      if [ "$top" = s ]; then
        # A single-quoted string carried over from a line above.
        t="${line:i}"
        case "$t" in
          *"'"*) d="${t%%\'*}"; word="$word$d"; i=$((i + ${#d} + 1)); ctx="${ctx%?}" ;;
          *) word="$word$t"; i=$n ;;
        esac
        continue
      fi
      if [ "$top" = d ]; then
        case "$c" in
          '"') ctx="${ctx%?}"; i=$((i + 1)) ;;
          '\')
            d="${line:i+1:1}"
            case "$d" in
              '$'|'`'|'"'|'\') word="$word$d"; i=$((i + 2)) ;;
              '') cont=1; i=$((i + 1)) ;;
              *) word="$word\\"; i=$((i + 1)) ;;
            esac ;;
          '$')
            d="${line:i+1:1}"
            if [ "$d" = "(" ]; then guard_open p 1; i=$((i + 2))
            elif [ "$d" = "{" ]; then
              word="$word$GUARD_UNKNOWN"; t="${line:i}"; t="${t%%\}*}"; i=$((i + ${#t} + 1))
            else word="$word\$"; i=$((i + 1)); fi ;;
          '`') guard_open b 1; i=$((i + 1)) ;;
          *)
            if [[ ${line:i} =~ $GUARD_RE_DQ ]]; then d="${BASH_REMATCH[0]}"; else d="$c"; fi
            word="$word$d"; i=$((i + ${#d})) ;;
        esac
        [ "$top" = d ] && inword=1
        continue
      fi
      case "$c" in
        ' '|"$GUARD_TAB") guard_word; i=$((i + 1)) ;;
        ';'|'&'|'|') guard_end; i=$((i + 1)) ;;
        '(') guard_open p 0; i=$((i + 1)) ;;
        ')')
          if [ "$top" = p ]; then guard_close; else guard_end; fi
          i=$((i + 1)) ;;
        '`')
          if [ "$top" = b ]; then guard_close; else guard_open b 1; fi
          i=$((i + 1)) ;;
        '<'|'>')
          # An fd number in front belongs to the redirection, and the word
          # after it is a file: neither is part of the command.
          case "$word" in
            ''|*[!0-9]*) guard_word ;;
            *) [ "$inword" = 1 ] && { word=""; inword=0; } ;;
          esac
          if [ "${line:i+1:1}" = "(" ]; then
            guard_open p 1; i=$((i + 2))
          else
            op="$c"; i=$((i + 1))
            while :; do
              case "${line:i:1}" in '<'|'>'|'&'|'|') op="$op${line:i:1}"; i=$((i + 1)) ;; *) break ;; esac
            done
            if [ "$op" = "<<" ] && [ "${line:i:1}" = "-" ]; then op="<<-"; i=$((i + 1)); fi
            case "$op" in
              '<<') drop=2; strip=0 ;;
              '<<-') drop=2; strip=1 ;;
              *) drop=1 ;;
            esac
          fi ;;
        '#')
          if [ "$inword" = 1 ]; then word="$word#"; i=$((i + 1)); else i=$n; fi ;;
        "'")
          t="${line:i+1}"
          case "$t" in
            *"'"*) d="${t%%\'*}"; word="$word$d"; i=$((i + ${#d} + 2)) ;;
            *) word="$word$t"; ctx="${ctx}s"; i=$n ;;
          esac
          inword=1 ;;
        '"') ctx="${ctx}d"; inword=1; i=$((i + 1)) ;;
        '\')
          d="${line:i+1:1}"
          if [ -z "$d" ]; then cont=1; i=$((i + 1))
          else word="$word$d"; inword=1; i=$((i + 2)); fi ;;
        '$')
          d="${line:i+1:1}"
          case "$d" in
            '(') guard_open p 1; i=$((i + 2)) ;;
            '"') ctx="${ctx}d"; inword=1; i=$((i + 2)) ;;
            "'")
              # $'…': its escapes are taken as the character after the backslash.
              t="${line:i+2}"; d=""
              while [ -n "$t" ]; do
                case "${t:0:1}" in
                  "'") t="${t:1}"; break ;;
                  '\') d="$d${t:1:1}"; t="${t:2}" ;;
                  *) d="$d${t:0:1}"; t="${t:1}" ;;
                esac
              done
              word="$word$d"; inword=1; i=$((n - ${#t})) ;;
            '{')
              word="$word$GUARD_UNKNOWN"; inword=1
              t="${line:i}"; t="${t%%\}*}"; i=$((i + ${#t} + 1)) ;;
            *) word="$word\$"; inword=1; i=$((i + 1)) ;;
          esac ;;
        *)
          if [[ ${line:i} =~ $GUARD_RE_PLAIN ]]; then d="${BASH_REMATCH[0]}"; else d="$c"; fi
          word="$word$d"; inword=1; i=$((i + ${#d})) ;;
      esac
    done
    # The end of the line: inside quotes it's part of the word; after a
    # backslash it's nothing; otherwise it ends the command.
    if [ "$cont" = 1 ]; then continue; fi
    top="${ctx:${#ctx}-1}"
    case "$top" in
      d|s) word="$word$GUARD_NL" ;;
      *) guard_end ;;
    esac
  done <<< "$1"
  guard_end
  # A heredoc still open at the end: what there is of it.
  if [ -n "$hd" ] && [ -n "$body" ]; then
    case "$hd" in *"$GUARD_US"1"$GUARD_RS"*) GUARD_SCRIPTS+=("$body") ;; esac
  fi
}

# True when the pattern ($1, its words joined by \037) matches the simple
# command in W whose program is at index $2.
guard_pattern() {
  local r="$1" j="$2" head w a m pos="" flags="" prevopt=0 endopts=0 opts="$GUARD_US" letters="" f ch
  head="${r%%$GUARD_US*}"; r="${r#*$GUARD_US}"
  case "$head" in
    */*) [ "${W[j]}" = "$head" ] || return 1 ;;
    *) [ "${W[j]##*/}" = "$head" ] || return 1 ;;
  esac
  while [ -n "$r" ]; do
    w="${r%%$GUARD_US*}"; r="${r#*$GUARD_US}"
    case "$w" in -?*) flags="$flags$w$GUARD_US" ;; *) pos="$pos$w$GUARD_US" ;; esac
  done
  m=$((j + 1))
  while [ "$m" -lt "$n" ]; do
    a="${W[m]}"; m=$((m + 1))
    if [ "$endopts" = 0 ]; then
      case "$a" in
        --) endopts=1; prevopt=0; continue ;;
        -?*)
          opts="$opts$a$GUARD_US"
          case "$a" in --*|*=*) ;; *) letters="$letters${a#-}" ;; esac
          case "$a" in *=*) prevopt=0 ;; *) prevopt=1 ;; esac
          continue ;;
      esac
    fi
    [ -n "$pos" ] || continue
    if [ "$a" = "${pos%%$GUARD_US*}" ]; then
      pos="${pos#*$GUARD_US}"; prevopt=0
    elif [ "$prevopt" = 1 ]; then
      # Perhaps the value of the option before it (`git -C dir push`).
      prevopt=0
    else
      return 1
    fi
  done
  [ -z "$pos" ] || return 1
  while [ -n "$flags" ]; do
    w="${flags%%$GUARD_US*}"; flags="${flags#*$GUARD_US}"
    case "$opts" in *"$GUARD_US$w$GUARD_US"*|*"$GUARD_US$w="*) continue ;; esac
    f="${w#-}"
    case "$f" in -*|*[!A-Za-z0-9]*) return 1 ;; esac
    while [ -n "$f" ]; do
      ch="${f:0:1}"; f="${f:1}"
      case "$letters" in *"$ch"*) ;; *) return 1 ;; esac
    done
  done
  return 0
}

# The command at W[$1] against every pattern; then, for a shell with -c or an
# eval, the script it runs.
guard_at() {
  local j="$1" k=0 a sawc=0 joined=""
  while [ "$k" -lt "${#GUARD_PW[@]}" ]; do
    if guard_pattern "${GUARD_PW[k]}" "$j"; then GUARD_HIT="${GUARD_PN[k]}"; return 0; fi
    k=$((k + 1))
  done
  k=$((j + 1))
  case "${W[j]##*/}" in
    eval)
      while [ "$k" -lt "$n" ]; do joined="$joined ${W[k]}"; k=$((k + 1)); done
      guard_check "$joined" $((depth + 1)) && return 0 ;;
    bash|sh|zsh|dash|ksh|fish)
      while [ "$k" -lt "$n" ]; do
        a="${W[k]}"; k=$((k + 1))
        case "$a" in
          --*) ;;
          -*c*) sawc=1 ;;
          -*) ;;
          *) [ "$sawc" = 1 ] && guard_check "$a" $((depth + 1)) && return 0 ;;
        esac
      done ;;
  esac
  return 1
}

# One simple command ($1, words joined by \037): past any assignments and
# reserved words to the program; past a wrapper (`env`, `sudo`, `xargs`…) to
# whatever it runs, tried at every word after it.
guard_command() {
  local r="$1" depth="$2" n=0 k=0
  local -a W
  while [ -n "$r" ]; do W[n]="${r%%$GUARD_US*}"; r="${r#*$GUARD_US}"; n=$((n + 1)); done
  while [ "$k" -lt "$n" ]; do
    case "${W[k]}" in
      if|then|else|elif|do|while|until|'!'|'{'|'}') k=$((k + 1)) ;;
      *) if [[ ${W[k]} =~ $GUARD_RE_ASSIGN ]]; then k=$((k + 1)); else break; fi ;;
    esac
  done
  [ "$k" -lt "$n" ] || return 1
  case "${W[k]##*/}" in
    env|command|builtin|exec|nohup|time|sudo|doas|nice|timeout|gtimeout|xargs|find|caffeinate|stdbuf|unbuffer)
      k=$((k + 1))
      while [ "$k" -lt "$n" ]; do guard_at "$k" && return 0; k=$((k + 1)); done
      return 1 ;;
  esac
  guard_at "$k"
}

# Every simple command in the shell text $1, and every script one of them hands
# to a shell. $2 is how deep in such scripts this is; four levels is plenty
# for an honest command.
guard_check() {
  local depth="$2" k c0 c1 s0 s1
  [ "$depth" -le 3 ] || return 1
  c0=${#GUARD_CMDS[@]}; s0=${#GUARD_SCRIPTS[@]}
  guard_split "$1"
  c1=${#GUARD_CMDS[@]}; s1=${#GUARD_SCRIPTS[@]}
  k=$c0
  while [ "$k" -lt "$c1" ]; do
    guard_command "${GUARD_CMDS[k]}" "$depth" && return 0
    k=$((k + 1))
  done
  k=$s0
  while [ "$k" -lt "$s1" ]; do
    guard_check "${GUARD_SCRIPTS[k]}" $((depth + 1)) && return 0
    k=$((k + 1))
  done
  return 1
}

# True when the hook payload $1 carries a command on the list. The pattern it
# matched is left in GUARD_HIT, and the command as Claude Code escaped it in
# GUARD_RAW. Needs `set +eu` and LC_ALL=C, which its callers set.
guard_matches() {
  local flat line w joined
  local -a words
  GUARD_HIT=""; GUARD_RAW=""; GUARD_LONG=0
  [ -s "$GUARD_LIST" ] || return 1
  [[ $1 =~ $GUARD_RE_COMMAND ]] || return 1
  GUARD_RAW="${BASH_REMATCH[1]}"
  guard_unescape "$GUARD_RAW"

  # Only the patterns whose every word is somewhere in the text, quotes and
  # backslashes aside, can match it: most calls end here.
  guard_flatten "$GUARD_TEXT"
  flat="$GUARD_FLAT"
  GUARD_PW=(); GUARD_PN=()
  set -f
  while IFS= read -r line || [ -n "$line" ]; do
    words=($line)
    [ "${#words[@]}" -gt 0 ] || continue
    joined=""
    for w in "${words[@]}"; do
      case "$w" in
        -*) ;;
        *) case "$flat" in *"${w##*/}"*) ;; *) continue 2 ;; esac ;;
      esac
      joined="$joined$w$GUARD_US"
    done
    GUARD_PW+=("$joined"); GUARD_PN+=("${words[*]}")
  done < "$GUARD_LIST"
  set +f
  [ "${#GUARD_PW[@]}" -gt 0 ] || return 1

  # Too long to read inside the hook's 10s, and it mentions every word of a
  # pattern: ask. A speed bump errs toward asking; a timeout would let the
  # call through unasked.
  if [ "${#GUARD_TEXT}" -gt "$GUARD_PARSE_MAX" ]; then
    GUARD_HIT="${GUARD_PN[0]}"; GUARD_LONG=1
    return 0
  fi
  GUARD_CMDS=(); GUARD_SCRIPTS=()
  guard_check "$GUARD_TEXT" 0
}

# `guard` (PreToolUse on Bash and Monitor): ask when the command is on the
# list. Says nothing otherwise, and on anything it can't read: a guard that
# fails must never break the call it was only meant to slow down.
guard_main() {
  local sid safe use dir esc rec reason
  set +eu
  export LC_ALL=C
  IFS= read -r -d '' GUARD_JSON
  guard_matches "$GUARD_JSON" || return 0

  # Asked: leave the notch the reason, then tell Claude Code to ask. One
  # record a call, under its tool_use_id: parallel guarded calls each raise a
  # PermissionRequest, and one shared record would leave all but the last
  # reading as unguarded. The app finds the one whose command it is.
  sid=""; use=""
  [[ $GUARD_JSON =~ $GUARD_RE_SESSION ]] && sid="${BASH_REMATCH[1]}"
  [[ ${GUARD_JSON##*\"tool_use_id\"} =~ $RQ_RE_USE ]] && use="${BASH_REMATCH[1]}"
  safe="${sid//[!A-Za-z0-9_-]/}"
  esc="$(json_escape "$GUARD_HIT")"
  dir="$GUARD_DIR/${safe:-unknown}"
  rec="$dir/${use:-unknown}.json"
  [ -d "$dir" ] || mkdir -p "$dir"
  printf '{"pattern": "%s", "command": "%s"}\n' "$esc" "$GUARD_RAW" > "$rec.tmp.$$" \
    && mv -f "$rec.tmp.$$" "$rec"
  if [ "$GUARD_LONG" = 1 ]; then
    reason="Guarded in Isle: too long to read, and it mentions \`$esc\`, which always asks."
  else
    reason="Guarded in Isle: matches \`$esc\`, which always asks."
  fi
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}\n' \
    "$reason"
}

CMD="${1:-}"
case "$CMD" in
  set-state)
    STATE="${2:-}"
    if [ -z "$STATE" ]; then
      echo "Usage: isle-cli set-state <disconnected|idle|working|done>" >&2
      exit 1
    fi
    ;;
  notify)
    STATE=""   # decided from the notification message below
    ;;
  fail)
    STATE="error"   # the turn ended on an API error (StopFailure hook)
    ;;
  ask|ask-question)
    STATE=""   # handled entirely in the `ask` block below
    ;;
  guard)
    # Before anything else is read or forked: off, or an empty list, and the
    # call goes on as if there were no hook at all.
    [ -s "$GUARD_LIST" ] || exit 0
    guard_main
    exit 0
    ;;
  subagent-start|subagent-stop)
    STATE=""   # the record keeps its state; see the subagent block below
    ;;
  denied)
    STATE=""   # the record keeps its state; see the PermissionDenied block below
    ;;
  end)
    STATE="disconnected"   # SessionEnd — clear the island (guarded below)
    ;;
  *)
    echo "Usage: isle-cli <set-state <state> | notify | fail | ask | ask-question | guard | subagent-start | subagent-stop | denied | end>" >&2
    exit 1
    ;;
esac

PROJECT="$(json_escape "$(basename "$PWD")")"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Pull fields out of the hook's stdin JSON without jq. Each `|| true` swallows a
# no-match exit so set -e/pipefail can't abort before the file is written (a
# matched value is already on stdout, so a real value is never clobbered).
SESSION_ID=""
ACTION=""
TARGET=""
MESSAGE=""
HOOK_EVENT=""
ERROR_TYPE=""
LAST_MSG=""
# The start of what Claude said last, for the Done face (Stop only).
LAST_EXCERPT=""
RESET_AT=""
# A usage limit (Milestone 19): which window was hit (five_hour, seven_day,
# seven_day_opus, seven_day_sonnet), and what Claude Code said comes next —
# `auto` (it will continue on its own at the reset), `enter` (the reset passed
# while the Mac slept, and it waits for Enter), `stopped` (it won't continue
# on its own), or `resumed` (it has continued). Empty when nothing said so.
LIMIT_KIND=""
LIMIT_NEXT=""
# The Notification's `notification_type`, the transcript's path (StopFailure),
# and the prompt (UserPromptSubmit) — each read only where it's used.
NTYPE=""
TRANSCRIPT=""
PROMPT=""
ERROR_DETAILS=""
# A subagent's id and type (SubagentStart / SubagentStop), and SessionStart's
# `source` (startup, resume, clear, compact).
AGENT_ID=""
AGENT_TYPE=""
SOURCE=""
# True only between a PreToolUse and its PostToolUse — i.e. a tool is
# actually executing right now. A long Bash or a slow MCP call goes minutes
# with no hook write and no transcript growth, which is indistinguishable
# from a stalled model unless the app knows a tool is running. Written as a
# bare JSON boolean, so it is unquoted in the status file.
TOOL_ACTIVE=false
if [ ! -t 0 ]; then
  STDIN_JSON="$(cat)"
  HOOK_EVENT="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"hook_event_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  if [ "$HOOK_EVENT" = "PreToolUse" ]; then TOOL_ACTIVE=true; fi
  ERROR_TYPE="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"error_type"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  # StopFailure names the failure `error`, not `error_type` — one of
  # rate_limit / overloaded / server_error / invalid_request /
  # model_not_found / max_output_tokens / unknown. Without this fallback
  # every failure arrived kind-less and the island could only ever show the
  # generic error marker. Gated to `fail` so a tool payload that happens to
  # carry an "error" key can't stamp a kind onto a non-failure write.
  if [ -z "$ERROR_TYPE" ] && [ "$CMD" = "fail" ]; then
    ERROR_TYPE="$(printf '%s' "$STDIN_JSON" \
      | grep -oE '"error"[[:space:]]*:[[:space:]]*"[^"]*"' \
      | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  fi
  SESSION_ID="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"session_id"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  ACTION="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  TARGET="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"(file_path|command|pattern|path|url)"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  TARGET="$(printf '%s' "$TARGET" | tr -d '\\')"
  # Reduce a bare file path to its last component, so a long absolute path
  # still shows its filename instead of being clipped mid-name by the cap
  # below. URLs (host matters) and command lines (first token matters) are
  # left for the app to reduce, so they're skipped here.
  case "$TARGET" in
    *"://"*) : ;;
    *" "*)   : ;;
    */*)     TARGET="${TARGET##*/}" ;;
  esac
  TARGET="$(printf '%s' "$TARGET" | cut -c1-48)"
  # A command's target is its program, read from the whole command (see
  # bash_program): the cut above can leave a long `cd` path, stop at an
  # escaped quote, or keep a comment line. Empty when it can't be named.
  case "$ACTION" in
    Bash|Monitor)
      TARGET=""
      bp_win="${STDIN_JSON:0:8192}"
      bp_cut=1
      if [[ $bp_win =~ $GUARD_RE_COMMAND ]]; then
        bp_cut=0
      else
        [[ $bp_win =~ $BP_RE_OPEN ]] || bp_win=""
      fi
      if [ -n "$bp_win" ]; then
        bp_raw="${BASH_REMATCH[1]}"
        if [ "${#bp_raw}" -gt 4096 ]; then bp_raw="${bp_raw:0:4096}"; bp_cut=1; fi
        guard_unescape "$bp_raw"
        bash_program "$GUARD_TEXT" "$bp_cut" || true
        TARGET="$BP_OUT"
      fi
      ;;
  esac
  MESSAGE="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"message"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
  # StopFailure carries no `message`: the text Claude actually showed
  # ("You've hit your weekly limit · resets …") rides in
  # `last_assistant_message`. The classification below reads both.
  LAST_MSG="$(printf '%s' "$STDIN_JSON" \
    | grep -oE '"last_assistant_message"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"

  # Stop: the first 300 characters of Claude's final message, so the Done
  # face can say what happened in Claude's own words. Kept exactly as Claude
  # Code escaped it — the text never leaves JSON form, so nothing here has to
  # escape it again — and cut on a whole token: an escape (\" \\ \n é),
  # or one character under a UTF-8 locale. So the cut can't land inside an
  # escape or a multi-byte character, and no bare quote or backslash can get
  # through. A \u escape for half a surrogate pair isn't a token, so the
  # excerpt simply ends before one. Two runs of 150 because 255 is the most
  # one repeat can count. A raw DEL (JSON allows one) is dropped; anything
  # that still isn't valid UTF-8 drops the excerpt, and the face says
  # "Finished responding" as before.
  if [ "$CMD" = "set-state" ] && [ "$HOOK_EVENT" = "Stop" ]; then
    tok='(\\u([0-9A-Ca-c][0-9A-Fa-f]{3}|[Dd][0-7][0-9A-Fa-f]{2}|[EFef][0-9A-Fa-f]{3})|\\["\\/bfnrt]|[^"\\])'
    LAST_EXCERPT="$(printf '%s' "$STDIN_JSON" \
      | LC_ALL=en_US.UTF-8 grep -oE "\"last_assistant_message\"[[:space:]]*:[[:space:]]*\"$tok{0,150}$tok{0,150}" \
      | head -1 \
      | LC_ALL=en_US.UTF-8 sed -E 's/^"last_assistant_message"[[:space:]]*:[[:space:]]*"//' \
      | LC_ALL=C tr -d '\000-\037\177' || true)"
    if ! printf '%s' "$LAST_EXCERPT" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
      LAST_EXCERPT=""
    fi
  fi

  case "$CMD" in
    notify)
      NTYPE="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"notification_type"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' | LC_ALL=C tr -cd 'a-z0-9_' || true)"
      ;;
    fail)
      TRANSCRIPT="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"transcript_path"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
      ERROR_DETAILS="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"error_details"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
      ;;
    set-state)
      if [ "$HOOK_EVENT" = "UserPromptSubmit" ]; then
        PROMPT="$(printf '%s' "$STDIN_JSON" \
          | grep -oE '"prompt"[[:space:]]*:[[:space:]]*"[^"]*"' \
          | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
      elif [ "$HOOK_EVENT" = "SessionStart" ]; then
        SOURCE="$(printf '%s' "$STDIN_JSON" \
          | grep -oE '"source"[[:space:]]*:[[:space:]]*"[^"]*"' \
          | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true)"
      fi
      ;;
    subagent-start|subagent-stop)
      # Both fields come before `last_assistant_message` in what 2.1.319
      # sends, so the first match is the hook's own. The id names a file and
      # the type sits in the record between quotes: each is cut to what can
      # do both safely.
      AGENT_ID="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"agent_id"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' | LC_ALL=C tr -cd 'A-Za-z0-9_-' | cut -c1-64 || true)"
      AGENT_TYPE="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"agent_type"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' | LC_ALL=C tr -cd 'A-Za-z0-9 _.:-' | cut -c1-64 || true)"
      ;;
    denied)
      # PermissionDenied (2.1.319): the base fields, then `tool_name`,
      # `tool_input`, `tool_use_id` and `reason` — auto mode's own words, a
      # category in brackets ("[Shared Scratch Sweep]") when the classifier
      # judged the call, or a sentence when it couldn't ("Classifier
      # unavailable"). The reason is the last key of its name, since a tool's
      # input may carry one too. Both texts are kept exactly as Claude Code
      # escaped them, cut on whole tokens (see the Stop excerpt above), so
      # neither can break the record. The command is a Bash or Monitor call's
      # first line, up to 48 characters, like every target here; `cut` says
      # whether there was more.
      BL_ID="$(printf '%s' "$STDIN_JSON" \
        | grep -oE '"tool_use_id"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' | LC_ALL=C tr -cd 'A-Za-z0-9_-' | cut -c1-64 || true)"
      BL_TOOL="$(printf '%s' "$ACTION" | LC_ALL=C tr -cd 'A-Za-z0-9_.:-' | cut -c1-64)"
      tok='(\\u([0-9A-Ca-c][0-9A-Fa-f]{3}|[Dd][0-7][0-9A-Fa-f]{2}|[EFef][0-9A-Fa-f]{3})|\\["\\/bfnrt]|[^"\\])'
      BL_REASON="$(printf '%s' "$STDIN_JSON" \
        | LC_ALL=en_US.UTF-8 grep -oE "\"reason\"[[:space:]]*:[[:space:]]*\"$tok{0,120}" \
        | tail -n 1 \
        | LC_ALL=en_US.UTF-8 sed -E 's/^"reason"[[:space:]]*:[[:space:]]*"//' \
        | LC_ALL=C tr -d '\000-\037\177' || true)"
      BL_CMD=""; BL_CUT=false
      case "$ACTION" in
        Bash|Monitor)
          # No \n, \r or \t in a token here: the excerpt ends with its line.
          ctok='(\\u([0-9A-Ca-c][0-9A-Fa-f]{3}|[Dd][0-7][0-9A-Fa-f]{2}|[EFef][0-9A-Fa-f]{3})|\\["\\/bf]|[^"\\])'
          BL_CMD="$(printf '%s' "$STDIN_JSON" \
            | LC_ALL=en_US.UTF-8 grep -oE "\"command\"[[:space:]]*:[[:space:]]*\"$ctok{0,48}" \
            | head -n 1 \
            | LC_ALL=en_US.UTF-8 sed -E 's/^"command"[[:space:]]*:[[:space:]]*"//' \
            | LC_ALL=C tr -d '\000-\037\177' || true)"
          if ! printf '%s' "$STDIN_JSON" \
               | LC_ALL=en_US.UTF-8 grep -qE "\"command\"[[:space:]]*:[[:space:]]*\"$ctok{0,48}\"" 2>/dev/null; then
            BL_CUT=true
          fi
          ;;
      esac
      if ! printf '%s' "$BL_REASON" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then BL_REASON=""; fi
      if ! printf '%s' "$BL_CMD" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then BL_CMD=""; BL_CUT=true; fi
      ;;
  esac
fi

# SubagentStart / SubagentStop (Milestone 22): count the agent in or out, and
# leave everything else in the record as it was. A stop for an agent this
# script never saw start changes nothing at all, so neither an internal agent
# nor a stop arriving after the turn's end can make a count up.
if [ "$CMD" = "subagent-start" ] || [ "$CMD" = "subagent-stop" ]; then
  agent_session="${SESSION_ID//[^A-Za-z0-9_-]/}"
  [ -n "$agent_session" ] && [ -n "$AGENT_ID" ] || exit 0
  agent_dir="$AGENT_DIR/$agent_session"
  if [ "$CMD" = "subagent-start" ]; then
    [ -e "$agent_dir/$AGENT_ID" ] && exit 0
    # By rename, so a write's read never sees an empty type. The temp name has
    # a dot, which the listing skips. Once more if a stop's rmdir took the
    # directory in between.
    for _ in 1 2; do
      mkdir -p "$agent_dir" 2>/dev/null || true
      if printf '%s\n' "$AGENT_TYPE" > "$agent_dir/$AGENT_ID.tmp.$$" 2>/dev/null \
         && mv -f "$agent_dir/$AGENT_ID.tmp.$$" "$agent_dir/$AGENT_ID" 2>/dev/null; then
        break
      fi
    done
  else
    [ -e "$agent_dir/$AGENT_ID" ] || exit 0
    rm -f "$agent_dir/$AGENT_ID"
    rmdir "$agent_dir" 2>/dev/null || true
  fi
  rewrite_subagents
  exit 0
fi

# PermissionDenied (Milestone 23): auto mode blocked a call. Keep it as the
# session's last block, counting the blocks since the last prompt, and put it in
# the record without changing the state: Claude Code tells the model and the
# turn carries on. Prints nothing, so the hook never asks for a retry. The same
# call reported twice (a duplicate hook entry) counts once.
if [ "$CMD" = "denied" ]; then
  bl_session="${SESSION_ID//[^A-Za-z0-9_-]/}"
  [ -n "$bl_session" ] || exit 0
  bl_file="$BLOCK_DIR/$bl_session.json"
  mkdir -p "$BLOCK_DIR" 2>/dev/null || true
  # One at a time per session, from reading the count to the record's
  # rewrite: blocks in parallel (auto mode judges each call of a batch) would
  # otherwise each read the same count and add one to it. A directory, since
  # making one is atomic; a holder that died leaves it, so after two seconds
  # (the work takes milliseconds) it is taken anyway.
  bl_lock="$BLOCK_DIR/.$bl_session.lock"
  bl_wait=0
  until mkdir "$bl_lock" 2>/dev/null; do
    bl_wait=$((bl_wait + 1))
    if [ "$bl_wait" -ge 100 ]; then
      rm -rf "$bl_lock"; mkdir "$bl_lock" 2>/dev/null || true
      break
    fi
    sleep 0.02
  done
  trap 'rmdir "$bl_lock" 2>/dev/null || true' EXIT
  bl_count=1
  if [ -f "$bl_file" ]; then
    bl_old="$(cat "$bl_file" 2>/dev/null || true)"
    if [ -n "$BL_ID" ] && [[ $bl_old == *"\"id\": \"$BL_ID\","* ]]; then exit 0; fi
    if [[ $bl_old =~ \"count\":\ ([0-9]{1,6}) ]]; then bl_count=$((BASH_REMATCH[1] + 1)); fi
  fi
  if printf '{"id": "%s", "tool": "%s", "target": "%s", "command": "%s", "cut": %s, "reason": "%s", "count": %s, "at": "%s"}\n' \
       "$BL_ID" "$BL_TOOL" "$TARGET" "$BL_CMD" "$BL_CUT" "$BL_REASON" "$bl_count" "$TIMESTAMP" \
       > "$bl_file.tmp.$$" 2>/dev/null && mv -f "$bl_file.tmp.$$" "$bl_file" 2>/dev/null; then
    rewrite_blocked
  fi
  exit 0
fi

# An approval or a question being waited on keeps the record until something
# ends the wait (see "A request being waited on"): another agent's tool, a
# notification, a compaction leave it exactly as it is. StopFailure and
# SessionEnd always end it, and a second `ask` takes the record as before.
if [ "$CMD" = "set-state" ] || [ "$CMD" = "notify" ]; then
  if live_request && ! ends_request "$LIVE_REQ"; then exit 0; fi
fi

# A new turn, or a new or ended session: the last one's block is history, as it
# is in Claude Code's own /permissions › Recently blocked. Not at Stop, so the
# Done face can still say why Claude didn't do something.
bl_session="${SESSION_ID//[^A-Za-z0-9_-]/}"
if [ -n "$bl_session" ] && [ -f "$BLOCK_DIR/$bl_session.json" ]; then
  case "$CMD:$HOOK_EVENT" in
    set-state:UserPromptSubmit|end:*)
      rm -f "$BLOCK_DIR/$bl_session.json" ;;
    set-state:SessionStart)
      [ "$SOURCE" = compact ] || rm -f "$BLOCK_DIR/$bl_session.json" ;;
  esac
fi
# The guarded calls' records, the same way: their approvals were the last
# turn's. (`end` takes them with the record, below.)
if [ -n "$bl_session" ] && [ -d "$GUARD_DIR/$bl_session" ]; then
  case "$CMD:$HOOK_EVENT" in
    set-state:UserPromptSubmit)
      rm -rf "$GUARD_DIR/$bl_session" ;;
    set-state:SessionStart)
      [ "$SOURCE" = compact ] || rm -rf "$GUARD_DIR/$bl_session" ;;
  esac
fi

# What a finished turn left running or scheduled (Milestone 20): said afresh at
# every Stop, before the record is written so it carries it; gone with the next
# prompt, a failed turn (StopFailure says nothing of it) or the session.
lt_session="${SESSION_ID//[^A-Za-z0-9_-]/}"
if [ "$CMD" = "set-state" ] && [ "$HOOK_EVENT" = "Stop" ]; then
  stop_leftovers || true
elif [ -n "$lt_session" ] && [ -f "$LEFT_DIR/$lt_session.json" ]; then
  case "$CMD:$HOOK_EVENT" in
    set-state:UserPromptSubmit|fail:*|end:*)
      rm -f "$LEFT_DIR/$lt_session.json" ;;
    set-state:SessionStart)
      [ "$SOURCE" = compact ] || rm -f "$LEFT_DIR/$lt_session.json" ;;
  esac
fi

# The session is over, or a new process has its id: whatever agents it had
# running are not counted past it. Not the turn's end or the next prompt: an
# agent sent to the background outlives its turn, and its own SubagentStop
# says when it's done. A compaction (SessionStart with source=compact) comes
# mid-session, while they still run, so it keeps them.
agent_session="${SESSION_ID//[^A-Za-z0-9_-]/}"
if [ -n "$agent_session" ] && [ -d "$AGENT_DIR/$agent_session" ]; then
  case "$CMD:$HOOK_EVENT" in
    end:*)
      rm -rf "$AGENT_DIR/$agent_session" ;;
    set-state:SessionStart)
      [ "$SOURCE" = compact ] || rm -rf "$AGENT_DIR/$agent_session" ;;
  esac
fi

# `ask` (PermissionRequest hook) and `ask-question` (PreToolUse, matched to
# AskUserQuestion): Claude is waiting on the user for this exact call. When
# Isle is there to answer, leave the request where it can see it and block
# until the notch decides, the prompt is answered somewhere else, or the
# deadline passes. Every way out but an answer from the notch prints nothing,
# and nothing is exactly what lets Claude fall back to its own prompt — so a
# timeout, a quit, a crash or a missing marker can only ever mean "ask in the
# terminal". Never allow on anyone's behalf.
if [ "$CMD" = "ask" ] || [ "$CMD" = "ask-question" ]; then
  if [ "$CMD" = "ask" ]; then
    KIND="approval"; WAIT_STATE="needs_approval"; WAIT_SECONDS=$ASK_APPROVAL_SECONDS
  else
    KIND="question"; WAIT_STATE="needs_question"; WAIT_SECONDS=$ASK_QUESTION_SECONDS
  fi

  # Nobody to answer (Isle isn't running, or the toggle is off), or nothing to
  # hand over: behave exactly as before the handshake existed — surface a
  # question, print nothing, return at once.
  #
  # Also a PermissionRequest *for AskUserQuestion*. Claude Code raises one the
  # moment `ask-question` returns without an answer (its deadline, or "Answer
  # in terminal") — that is how the terminal's question UI comes up. It is the
  # same question, already handed to the terminal, and it is not a tool
  # approval: Approve / Deny would be the wrong buttons for it.
  if [ -z "${STDIN_JSON:-}" ] || ! isle_answering \
     || { [ "$CMD" = "ask" ] && [ "$ACTION" = "AskUserQuestion" ]; }; then
    write_status "needs_question" ""
    exit 0
  fi

  # Session-scoped, and unique per hook process. The trailing pid is the
  # hook's own, which Isle uses to tell a waiting hook from a SIGKILLed one.
  SAFE_SESSION="$(printf '%s' "${SESSION_ID:-}" | tr -cd 'A-Za-z0-9_-')"
  REQUEST_ID="${SAFE_SESSION:-unknown}-$(date +%s)-$$"
  REQUEST_FILE="$REQUEST_DIR/$REQUEST_ID.json"
  RESPONSE_FILE="$REQUEST_DIR/$REQUEST_ID.response.json"
  STATUS_FILE="$SESSION_DIR/${SESSION_ID:-unknown}.json"

  # The request lives exactly as long as this process. Whatever ends the wait
  # — an answer, the deadline, Claude Code's SIGTERM at the hook's timeout — it
  # goes, and with it Isle's buttons.
  trap 'rm -f "$REQUEST_FILE" "$RESPONSE_FILE" "$REQUEST_FILE.tmp.$$"' EXIT
  trap 'exit 0' TERM INT HUP

  # The raw stdin, verbatim: Isle reads the full tool_input (the exact command,
  # the questions) from it, not the status file's trimmed target. By rename,
  # like every other write here — and the temp name doesn't end in .json.
  mkdir -p "$REQUEST_DIR"
  printf '%s' "$STDIN_JSON" > "$REQUEST_FILE.tmp.$$"
  mv -f "$REQUEST_FILE.tmp.$$" "$REQUEST_FILE"
  write_status "$WAIT_STATE" "$REQUEST_ID" "$KIND"

  SECONDS=0
  while :; do
    if [ -f "$RESPONSE_FILE" ]; then
      RESPONSE="$(cat "$RESPONSE_FILE" 2>/dev/null || true)"
      case "$RESPONSE" in
        ''|'{}')
          # "Answer in terminal": no decision. Claude shows its own prompt the
          # moment this exits; drop the id so nothing offers buttons for it.
          write_status "$WAIT_STATE" ""
          ;;
        *)
          # Decided in the notch. Claude moves on either way — the tool runs,
          # or the model hears the denial and tries something else — so the
          # island stops asking now rather than at the next hook.
          case "$RESPONSE" in
            *'"behavior":"allow"'*|*'"permissionDecision":"allow"'*) TOOL_ACTIVE=true ;;
            *) TOOL_ACTIVE=false ;;
          esac
          # "Always…" never covers a guarded command. The notch doesn't offer
          # it for one, and Claude Code sends no suggestions to save after a
          # hook's ask; this is the last word, in case either ever changes:
          # the call is allowed once, and no rule or mode is saved.
          case "$ACTION:$RESPONSE" in
            Bash:*'"updatedPermissions"'*|Monitor:*'"updatedPermissions"'*)
              if ( set +eu; export LC_ALL=C; guard_matches "$STDIN_JSON" ); then
                RESPONSE='{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}'
              fi ;;
          esac
          write_status "working" ""
          printf '%s\n' "$RESPONSE"
          ;;
      esac
      exit 0
    fi

    # Another verb has written this session's status since — the tool ran
    # (PostToolUse), the turn ended, a new prompt arrived. That's how an answer
    # given in the terminal shows up: Claude Code doesn't stop a hook whose
    # prompt was answered elsewhere, and ignores what it prints afterwards. So
    # step aside without a word or a write; the status is already newer. Only
    # what ends the wait writes over it (see "A request being waited on"), so
    # another agent's tool calls don't. Read with builtins, five times a second.
    held=""
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in *"\"request_id\": \"$REQUEST_ID\""*) held=1; break ;; esac
    done 2>/dev/null < "$STATUS_FILE" || true
    [ -n "$held" ] || exit 0

    # Out of time, or Isle went away (quit, crash, toggle off): hand the prompt
    # back to Claude. The status keeps its state — the prompt is still up — but
    # loses the id, so no button outlives the wait.
    if [ "$SECONDS" -ge "$WAIT_SECONDS" ] || ! isle_answering; then
      write_status "$WAIT_STATE" ""
      exit 0
    fi

    sleep 0.2
  done
fi

# Route a Notification by its `notification_type`. Only the types that mean
# something for the island change it: a prompt waiting in the terminal is a
# question, the idle nudge is calmer, and the usage-limit wait's three
# outcomes say what came of it. Everything else — a sign-in, an MCP form
# finishing, a background session done, a mod's own notice, a type newer
# than this script — leaves the state exactly as it was: none of them means
# this session needs you, and saying so would be a guess.
if [ "$CMD" = "notify" ]; then
  sf="$SESSION_DIR/${SESSION_ID:-unknown}.json"
  # An approval that `ask` is blocked on is kept above: the permission_prompt
  # notification lands a few seconds into the wait, and rewriting the status
  # would drop the request id the hook is waiting under.
  case "$NTYPE" in
    permission_prompt|elicitation_dialog|elicitation_url_dialog|idle_prompt|'')
      # Keep an active question: a question (from the AskUserQuestion tool)
      # is the more specific signal, and the notification that follows it is
      # just "waiting on you" for the same prompt — don't let it downgrade.
      # The question clears on its own when Claude moves on.
      if [ -f "$sf" ] && grep -q '"state": "needs_question"' "$sf" 2>/dev/null; then
        exit 0
      fi
      ;;
  esac
  case "$NTYPE" in
    permission_prompt|elicitation_dialog|elicitation_url_dialog)
      STATE="needs_question" ;;
    idle_prompt)
      STATE="waiting_input" ;;
    quota_auto_resume_fired)
      # Claude Code has picked the task up again. Not over a tool that is
      # already running (the continued turn got there first): that write
      # is the newer one.
      if [ -f "$sf" ] && grep -q '"state": "working"' "$sf" 2>/dev/null \
         && grep -q '"tool_active": true' "$sf" 2>/dev/null; then
        exit 0
      fi
      STATE="working"; LIMIT_NEXT="resumed"
      if [ -f "$sf" ] && grep -qE '"(error_type": "usage_limit|limit_next": "resumed)"' "$sf" 2>/dev/null; then
        LIMIT_KIND="$(record_field limit_kind "$sf" || true)"
      fi
      ;;
    quota_auto_resume_stale|quota_auto_resume_disabled)
      # The limit, still: the reset passed while the Mac slept and Claude
      # Code waits for Enter, or it has stopped waiting and won't continue.
      # The window and the reset are the limit's own, kept from its record.
      STATE="error"; ERROR_TYPE="usage_limit"
      if [ "$NTYPE" = quota_auto_resume_stale ]; then LIMIT_NEXT="enter"; else LIMIT_NEXT="stopped"; fi
      if [ -f "$sf" ] && grep -q '"error_type": "usage_limit"' "$sf" 2>/dev/null; then
        LIMIT_KIND="$(record_field limit_kind "$sf" || true)"
        RESET_AT="$(record_field reset_at "$sf" || true)"
      fi
      ;;
    '')
      # A Claude Code too old to send the type: the message is all there is.
      # The idle nudge says "waiting"; anything else asked for attention.
      lower="$(printf '%s' "$MESSAGE" | tr '[:upper:]' '[:lower:]')"
      case "$lower" in
        *waiting*) STATE="waiting_input" ;;
        *)         STATE="needs_question" ;;
      esac
      ;;
    *)
      exit 0 ;;
  esac
  # The idle nudge comes a minute after a Stop, about the same finished turn:
  # keep what Claude said, copied from the record verbatim (it is already
  # escaped and checked), so the face doesn't lose it to the nudge. A new
  # prompt writes `working`, which drops it.
  if [ "$STATE" = "waiting_input" ] && [ -f "$sf" ]; then
    LAST_EXCERPT="$(LC_ALL=C grep -oE '"last_message": "([^"\\]|\\.)*"' "$sf" 2>/dev/null \
      | head -1 | LC_ALL=C sed -E 's/^"last_message": "//; s/"$//' || true)"
    if ! printf '%s' "$LAST_EXCERPT" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
      LAST_EXCERPT=""
    fi
  fi
fi

# A PreToolUse for AskUserQuestion belongs to `ask-question`, which Claude Code
# runs in parallel with this generic entry (it has its own matcher) and which
# owns the request id. Writing here as well would race it, and a write landing
# after its own would drop the id and end the wait it's in. So stand aside.
if [ "$CMD" = "set-state" ] && [ "$ACTION" = "AskUserQuestion" ] \
   && [ "$HOOK_EVENT" = "PreToolUse" ]; then
  exit 0
fi

# A tool that asks the user a question surfaces as a question, not plain work —
# but only while it's being *asked* (PreToolUse). The matching PostToolUse fires
# when the question is answered; letting it convert too would re-raise the
# question forever and the notch would never close. Absent hook_event_name we
# keep the old behaviour (convert), so a lone PreToolUse still opens.
if [ "$CMD" = "set-state" ] && [ "$STATE" = "working" ] && [ "$ACTION" = "AskUserQuestion" ] \
   && [ "$HOOK_EVENT" != "PostToolUse" ] && [ "$HOOK_EVENT" != "PostToolUseFailure" ]; then
  STATE="needs_question"
fi

# A turn Claude Code continued after a usage limit stays "resumed" until it
# ends: the continuation's own prompt (Claude Code's words, "Your claude.ai
# usage limit has reset. Continue the task you were working on…") says so,
# and so does the fired notification, whichever lands first; every tool call
# after keeps it. Your own prompt is a turn of your own, and drops it.
if [ "$CMD" = "set-state" ] && [ "$STATE" = "working" ]; then
  sf="$SESSION_DIR/${SESSION_ID:-unknown}.json"
  if [ "$HOOK_EVENT" = "UserPromptSubmit" ]; then
    case "$PROMPT" in
      "Your claude.ai usage "*"Continue the task you were working on"*) LIMIT_NEXT="resumed" ;;
    esac
  elif [ -f "$sf" ] && grep -q '"limit_next": "resumed"' "$sf" 2>/dev/null; then
    LIMIT_NEXT="resumed"
  fi
  if [ "$LIMIT_NEXT" = "resumed" ] && [ -f "$sf" ] \
     && grep -qE '"(error_type": "usage_limit|limit_next": "resumed)"' "$sf" 2>/dev/null; then
    LIMIT_KIND="$(record_field limit_kind "$sf" || true)"
  fi
fi

# The Claude usage/subscription limit is distinct from a transient API error:
# it resets on a schedule rather than being worth an immediate retry. Detect it
# from the error type or the words (a failure, or a notification from a
# Claude Code too old to name its type) and surface it as a named failure.
if [ "$CMD" = "fail" ] || { [ "$CMD" = "notify" ] && [ -z "$NTYPE" ]; }; then
  lc_all="$(printf '%s %s %s' "$ERROR_TYPE" "$MESSAGE" "$LAST_MSG" \
    | tr '[:upper:]' '[:lower:]')"
  # Claude sends `rate_limit` for both a transient 429 and the subscription
  # limit, so the wording is what separates them: the subscription limit
  # reads "You've hit your <5-hour|weekly|…> limit". "API Error: Rate limit
  # reached" is the transient one, and is not a limit with a reset.
  case "$lc_all" in
    *"rate limit reached"*) : ;;
    *usage*limit*|*limit*reached*|*quota*|*"hit your"*limit*)
      STATE="error"; ERROR_TYPE="usage_limit" ;;
  esac
fi

# The limit's reset and window, from the best source there is (see "Usage
# limits" above): a reset in StopFailure's own `error_details`, should it ever
# carry one; else the transcript, which is also the only thing that can say
# Claude Code will continue on its own; else an epoch in the message (the old
# "…reached|1719849600" form); else the words. Absent all of them, RESET_AT
# stays empty and the app pins the limit with no reset time.
if [ "$ERROR_TYPE" = "usage_limit" ] && [ "$CMD" != "notify" -o -z "$NTYPE" ]; then
  set +eu +o pipefail
  now="${ISLE_CLI_NOW:-$(date +%s)}"
  sf="$SESSION_DIR/${SESSION_ID:-unknown}.json"
  # Every write is a rename, so a new write is a new inode, even one whose
  # words match the last.
  before="$(stat -f %i "$sf" 2>/dev/null) $(cat "$sf" 2>/dev/null)"
  cand="$(printf '%s' "$ERROR_DETAILS" | grep -oE '[0-9]{10,13}' | head -n 1)"
  [ "${#cand}" -eq 13 ] && cand="${cand:0:10}"
  plausible_reset "$cand" "$now" && RESET_AT="$cand"
  if [ "$CMD" = "fail" ]; then
    limit_from_transcript "$TRANSCRIPT" "$now"
    [ -n "$RESET_AT" ] || RESET_AT="$TR_RESET"
    LIMIT_KIND="$TR_KIND"
    [ "$TR_AUTO" = 1 ] && LIMIT_NEXT="auto"
  fi
  if [ -z "$RESET_AT" ]; then
    cand="$(printf '%s %s' "$MESSAGE" "$LAST_MSG" | grep -oE '[0-9]{10,13}' | head -n 1)"
    [ "${#cand}" -eq 13 ] && cand="${cand:0:10}"
    plausible_reset "$cand" "$now" && RESET_AT="$cand"
  fi
  if [ -z "$RESET_AT" ] || [ -z "$LIMIT_KIND" ]; then
    limit_from_text "$LAST_MSG $MESSAGE" "$now"
    [ -n "$RESET_AT" ] || RESET_AT="$TEXT_RESET"
    [ -n "$LIMIT_KIND" ] || LIMIT_KIND="$TEXT_KIND"
  fi
  LIMIT_KIND="$(printf '%s' "$LIMIT_KIND" | LC_ALL=C tr -cd 'a-z0-9_')"
  # The transcript can take a moment; a newer hook that wrote meanwhile (the
  # prompt you typed, a resume) is the truth now, and this is not.
  if [ "$(stat -f %i "$sf" 2>/dev/null) $(cat "$sf" 2>/dev/null)" != "$before" ]; then exit 0; fi
fi

# `end` (SessionEnd hook): drop this session's file and stop. With one file
# per session there's nothing to guard against any more — removing your own
# record can't affect anyone else's. (The old shared-file version had to
# check whether it still owned the island before clearing it.)
if [ "$CMD" = "end" ]; then
  guard_session="$(printf '%s' "${SESSION_ID:-unknown}" | tr -cd 'A-Za-z0-9_-')"
  rm -f "$SESSION_DIR/${SESSION_ID:-unknown}.json" "$GUARD_DIR/$guard_session.json"
  [ -z "$guard_session" ] || rm -rf "$GUARD_DIR/$guard_session"
  exit 0
fi

write_status "$STATE" ""
