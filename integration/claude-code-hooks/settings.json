{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state working" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state working" }] },
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "isle-cli ask-question", "timeout": 60 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "isle-cli ask", "timeout": 330 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state working" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "isle-cli notify" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state done" }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "isle-cli fail" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state compacting" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "isle-cli set-state idle" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "isle-cli end" }] }
    ]
  }
}
