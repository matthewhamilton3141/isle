*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# The adapter framework is a compiled binary reproducible from
# scripts/build-mediaremote-adapter.sh (pinned to a tagged upstream release),
# so it doesn't belong in git. It's also ad-hoc signed, and code signatures
# don't survive a round-trip through version control intact.
#
# Run the script after cloning or media playback won't work. The Xcode build
# phase emits a warning rather than failing if it's absent.
#
# The .pl driver and the upstream BSD-3 license text ARE tracked: they're small,
# readable, and keeping the license in-repo preserves attribution.
Vendor/mediaremote-adapter/MediaRemoteAdapter.framework/

# Release artifacts (built by scripts/sign-release.sh)
dist/

# Windows port
windows/node_modules/

# Video working files for the README demo (the GIF is tracked)
assets/*.mp4
